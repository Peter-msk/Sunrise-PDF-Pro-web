{
  "name": "sunrise-pdf-pro-browser-local",
  "version": "0.38.0-local-integrated",
  "private": true,
  "type": "module",
  "description": "Integrated browser-local HWP/HWPX to PDF converter (stable raster + opt-in vector)",
  "scripts": {
    "build": "node scripts/copy-wasm.mjs && vite build && node scripts/verify-local-build.mjs",
    "dev": "node scripts/copy-wasm.mjs && vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/unit.mjs",
    "check:source": "node scripts/check-source.mjs",
    "test:local": "npm run check:source && npm test",
    "diagnose": "node scripts/diagnose-local.mjs",
    "verify:dist": "node scripts/verify-local-build.mjs",
    "test:hwp": "node tests/real-hwp-local-e2e.mjs",
    "test:wasm": "node tests/stage1-browser-boot.mjs",
    "stage1:verify": "npm run build && npm run test:wasm && npm run diagnose",
    "test:engine": "node --test tests/page-geometry.mjs tests/pdfkit-backend.mjs"
  },
  "dependencies": {
    "@rhwp/core": "0.8.7",
    "pdf-lib": "1.17.1",
    "@pdf-lib/fontkit": "1.1.1",
    "pdfkit": "0.20.2",
    "svg-to-pdfkit": "0.1.8",
    "blob-stream": "0.1.3"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "playwright": "1.56.1"
  }
}
