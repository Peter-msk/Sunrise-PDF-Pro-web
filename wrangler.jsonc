{
  "name": "sunrise-pdf-pro-web",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./browser-local/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "PRO_ADMIN_DB",
      "database_name": "sunrise-pdf-pro-admin",
      "database_id": "d7fd7866-2ac2-485f-8d4b-4773b69d99e4"
    }
  ]
}
