@@ -0,0 +1,42 @@
+/** R66-DEV9 — browser own-engine stream phase contract; no native COM. */
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+
+const source=readFileSync(new URL('../src/svg-professional.js',import.meta.url),'utf8');
+const ui=readFileSync(new URL('../src/main.js',import.meta.url),'utf8');
+const hit=source.match(/pending=toBlob\(pdf,writerAbort\.signal,\(\{bytes\}\)=>\{([\s\S]*?)\n    \}\);/);
+assert(hit,'R66_DEV9_PDF_BYTE_CALLBACK_MISSING');
+// Evaluate the actual callback body, without loading PDFKit, rhwp or the DOM.
+const callback=(observer,{count=12,page=12,finalizing=false}={})=>
+  new Function('onProgress','count','currentPdfPage','reportingFinalStream',
+    `return ({bytes})=>{${hit[1]}\n};`)
+    (observer,count,page,finalizing);
+
+test('PDF bytes during final page drawing have pdf_write phase',()=>{
+  const output=[];
+  callback(e=>output.push(e))({bytes:1_048_576});
+  assert.deepEqual(output,[{stage:'professional',page:12,total:12,detail:'pdf_write',bytes:1_048_576}]);
+});
+test('only finalization bytes have pdf_stream phase',()=>{
+  const output=[];
+  callback(e=>output.push(e),{finalizing:true})({bytes:2_048_576});
+  assert.deepEqual(output,[{stage:'professional',page:12,total:12,detail:'pdf_stream',bytes:2_048_576}]);
+});
+test('byte events retain the current SVG page',()=>{
+  const output=[];
+  callback(e=>output.push(e),{page:3})({bytes:200});
+  assert.equal(output[0].page,3);
+});
+test('a broken UI callback must not fail PDFKit emission',()=>{
+  assert.doesNotThrow(()=>callback(()=>{throw Error('UI_FAIL')})({bytes:1024}));
+});
+test('conversion stage labels distinguish write and finalization',()=>{
+  assert.match(ui,/pdf_write:'페이지 PDF 작성 중'/);
+  assert.match(ui,/pdf_stream:'PDF 바이트 생성 중'/);
+  assert.match(ui,/info\.detail==='pdf_write'/);
+});
+test('PDF completion event remains after header validation',()=>{
+  assert.ok(source.indexOf("PROFESSIONAL_PDF_INVALID_HEADER")<
+    source.lastIndexOf("detail:'pdf_done'"));
+});
diff --git a/browser-local/tests/r66-pdf-output-integrity.mjs b/browser-local/tests/r66-pdf-output-integrity.mjs
new file mode 100644
index 0000000..3519454
--- /dev/null
+++ b/browser-local/tests/r66-pdf-output-integrity.mjs
@@ -0,0 +1,99 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {EventEmitter} from 'node:events';
+import {createPdfOutputGuard,assertCompletePdfBytes} from '../src/pdf-output-integrity.mjs';
+import {loadBrowserPdfBackend} from '../src/pdfkit-backend.js';
+const pdf=readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url));
+const bytes=()=>new Uint8Array(pdf);
+const encoder=new TextEncoder();
+class StreamPdf extends EventEmitter{destroy(){this.destroyed=true;}}
+async function backend(){return loadBrowserPdfBackend(async name=>{
+ if(name==='pdfkit')return {PDFDocument:StreamPdf,registerStdFonts(){}};
+ if(name==='svg-to-pdfkit')return {default:()=>{}};
+ if(name==='pdfkit/standard-fonts/Helvetica')return {default:{}};
+ throw Error(name);
+});}
+
+// These are structural checks; the fixture is also read by PyMuPDF and pypdf
+// in the external acceptance script. Do not overstate as PDF parse validation.
+test('real two-page PDF has complete header/startxref/EOF',()=>{
+ const b=bytes(),r=assertCompletePdfBytes(b);
+ assert.equal(r,b);
+});
+test('one-byte streaming chunks work across boundary tokens',()=>{
+ const guard=createPdfOutputGuard(),parts=[];
+ for(const n of bytes()){const part=new Uint8Array([n]);guard.append(part);parts.push(part);}
+ assert.equal(guard.finish(parts).bytes,pdf.length);
+});
+test('uneven streaming chunk boundaries preserve tail and exact length',()=>{
+ const guard=createPdfOutputGuard();const b=bytes();
+ let i=0;
+ for(const step of [1,5,3,512,11,99,123,2048]){
+  guard.append(b.subarray(i,Math.min(b.length,i+step)));
+  i=Math.min(b.length,i+step);
+ }
+ guard.append(b.subarray(i));
+ assert.equal(guard.bytes,b.length);assert.equal(guard.finish([b]).bytes,b.length);
+});
+test('valid PDF with harmless trailing linebreaks remains supported',()=>{
+ const b=bytes();
+ assertCompletePdfBytes(new Uint8Array([...b,10,13,10]));
+});
+test('missing entire PDF body fails header check',()=>{
+ assert.throws(()=>assertCompletePdfBytes(encoder.encode('image/png\0'.repeat(9))),/PDF_OUTPUT_HEADER_INVALID/);
+});
+test('truncated final PDF EOF fails closed',()=>{
+ const b=bytes();
+ const text=Buffer.from(b).toString('latin1');
+ const end=text.lastIndexOf('%%EOF');assert.ok(end>=0);
+ assert.throws(()=>assertCompletePdfBytes(b.subarray(0,end)),/PDF_OUTPUT_TRAILER_INCOMPLETE/);
+});
+test('header-only stream is not accepted as completed PDF',()=>{
+ assert.throws(()=>assertCompletePdfBytes(encoder.encode('%PDF-1.7\n'+'x'.repeat(70))),/PDF_OUTPUT_TRAILER_INCOMPLETE/);
+});
+test('fake EOF without startxref is rejected',()=>{
+ assert.throws(()=>assertCompletePdfBytes(encoder.encode('%PDF-1.7\n'+'.'.repeat(100)+'\n%%EOF\n')),/PDF_OUTPUT_TRAILER_INCOMPLETE/);
+});
+test('out of bounds xref offset fails closed',()=>{
+ const b=bytes();const s=Buffer.from(b).toString('latin1');
+ const mutated=encoder.encode(s.replace(/startxref\s+[0-9]+\s+%%EOF/,'startxref\n999999999\n%%EOF'));
+ assert.throws(()=>assertCompletePdfBytes(mutated),/PDF_OUTPUT_XREF_OFFSET_INVALID/);
+});
+test('no unbounded output exceeds a byte budget',()=>{
+ assert.throws(()=>assertCompletePdfBytes(bytes(),100),/PDF_OUTPUT_BYTES_LIMIT/);
+ assert.throws(()=>createPdfOutputGuard(513*1024*1024),/PDF_OUTPUT_BUDGET_INVALID/);
+});
+test('finish cannot be called twice or append after finish',()=>{
+ const g=createPdfOutputGuard();g.append(bytes());g.finish(bytes());
+ assert.throws(()=>g.finish(),/ALREADY_FINISHED/);
+ assert.throws(()=>g.append(bytes()),/ALREADY_FINISHED/);
+});
+test('the PDFKit browser output path rejects a truncated stream at end',async()=>{
+ const b=await backend(),pdf=new StreamPdf(),pending=b.toBlob(pdf);
+ pdf.emit('data',encoder.encode('%PDF-1.7\ntruncated'));
+ pdf.emit('end');
+ await assert.rejects(pending,/PDF_OUTPUT_TRAILER_INCOMPLETE|PDF_OUTPUT_HEADER_INVALID/);
+ assert.equal(pdf.listenerCount('data'),0);assert.equal(pdf.listenerCount('end'),0);
+});
+test('the PDFKit browser output path returns a real two-page PDF Blob',async()=>{
+ const b=await backend(),stream=new StreamPdf(),events=[];
+ const pending=b.toBlob(stream,undefined,p=>events.push(p.bytes));
+ const input=bytes();
+ stream.emit('data',input.subarray(0,5));
+ stream.emit('data',input.subarray(5,1000));
+ stream.emit('data',input.subarray(1000));
+ stream.emit('end');
+ const blob=await pending;
+ assert.equal(blob.size,input.length);assert.deepEqual(new Uint8Array(await blob.arrayBuffer()),input);
+ assert.equal(events.at(-1),input.length);
+});
+test('PDFKit chunk size budget and cancellation protections remain active',async()=>{
+ const lib=await backend(),stream=new StreamPdf();const pending=lib.toBlob(stream,undefined,()=>{},100);
+ stream.emit('data',bytes());
+ await assert.rejects(pending,/PDF_STREAM_OUTPUT_BYTES_LIMIT/);
+ assert.equal(stream.destroyed,true);
+ const ctrl=new AbortController(),next=new StreamPdf();const p2=lib.toBlob(next,ctrl.signal);
+ next.emit('data',bytes().subarray(0,24));ctrl.abort();
+ await assert.rejects(p2,{name:'AbortError'});
+});
diff --git a/browser-local/tests/r66-pdf-stream-progress.mjs b/browser-local/tests/r66-pdf-stream-progress.mjs
new file mode 100644
index 0000000..86df7cb
--- /dev/null
+++ b/browser-local/tests/r66-pdf-stream-progress.mjs
@@ -0,0 +1,70 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {EventEmitter} from 'node:events';
+import {readFileSync} from 'node:fs';
+const validPdf=readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url));
+function largeValidPdf(){
+ const text=validPdf.toString('latin1');
+ const m=/startxref\s+(\d+)/.exec(text);if(!m)throw Error('FIXTURE_MISSING_XREF');
+ const offset=Number(m[1]);
+ const filler=Buffer.from('%'+'x'.repeat(1022)+'\n').toString().repeat(2048);
+ const joined=text.slice(0,offset)+filler+text.slice(offset);
+ return Buffer.from(joined.replace(/startxref\s+\d+/, 'startxref\n'+(offset+filler.length)),'latin1');
+}
+import {loadBrowserPdfBackend} from '../src/pdfkit-backend.js';
+
+class StubPdf extends EventEmitter {}
+async function backend(){
+ return loadBrowserPdfBackend(async name=>{
+  if(name==='pdfkit')return {PDFDocument:StubPdf,registerStdFonts(){}};
+  if(name==='svg-to-pdfkit')return {default:()=>{}};
+  if(name==='pdfkit/standard-fonts/Helvetica')return {default:{family:'Helvetica'}};
+  throw Error('UNEXPECTED_IMPORT');
+ });
+}
+const encoded=s=>new TextEncoder().encode(s);
+
+test('R66-DEV2 PDFKit chunk progress counts real emitted bytes and final end',async()=>{
+ const lib=await backend(),pdf=new lib.PDFDocument(),events=[];
+ const promise=lib.toBlob(pdf,undefined,data=>events.push(data.bytes));
+ const part=validPdf.subarray(0,101);
+ pdf.emit('data',part);pdf.emit('data',validPdf.subarray(101));
+ pdf.emit('end');
+ const blob=await promise;
+ assert.equal(blob.size,validPdf.length);
+ assert.equal(events.at(-1),blob.size);
+ assert.ok(events.every((n,i)=>!i||n>=events[i-1]));
+ assert.equal(pdf.listenerCount('data'),0);
+ assert.equal(pdf.listenerCount('end'),0);
+});
+test('R66-DEV2 progress observer error cannot corrupt an otherwise valid PDF stream',async()=>{
+ const lib=await backend(),pdf=new lib.PDFDocument();
+ const promise=lib.toBlob(pdf,undefined,()=>{throw Error('UI_FAILED');});
+ pdf.emit('data',validPdf);pdf.emit('end');
+ assert.match(await (await promise).text(),/^%PDF-/);
+});
+test('R66-DEV2 large chunks produce byte progress without artificial delay',async()=>{
+ const lib=await backend(),pdf=new lib.PDFDocument(),progress=[];
+ const promise=lib.toBlob(pdf,undefined,meta=>progress.push(meta.bytes));
+ const large=largeValidPdf();
+ pdf.emit('data',large.subarray(0,1024*1024));
+ pdf.emit('data',large.subarray(1024*1024));pdf.emit('end');
+ assert.equal((await promise).size,large.length);
+ assert.equal(progress.at(-1),large.length);
+});
+test('R66-DEV2 cancel disposes data/end listeners and rejects',async()=>{
+ const lib=await backend(),pdf=new lib.PDFDocument(),controller=new AbortController();
+ const promise=lib.toBlob(pdf,controller.signal,()=>{});
+ pdf.emit('data',encoded('partial'));
+ controller.abort();
+ await assert.rejects(promise,error=>error.name==='AbortError');
+ assert.equal(pdf.listenerCount('data'),0);
+ assert.equal(pdf.listenerCount('end'),0);
+});
+test('R66-DEV2 malformed PDFKit output chunk fails closed',async()=>{
+ const lib=await backend(),pdf=new lib.PDFDocument();
+ const promise=lib.toBlob(pdf);
+ pdf.emit('data','invalid chunk');
+ await assert.rejects(promise,/바이트 형식/);
+ assert.equal(pdf.listenerCount('data'),0);
+});
diff --git a/browser-local/tests/r66-pdf-writer-disposal.mjs b/browser-local/tests/r66-pdf-writer-disposal.mjs
new file mode 100644
index 0000000..bdf3f6b
--- /dev/null
+++ b/browser-local/tests/r66-pdf-writer-disposal.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {EventEmitter} from 'node:events';
+import {readFileSync} from 'node:fs';
+import {linkPdfWriterAbort} from '../src/pdf-stream-abort.mjs';
+import {loadBrowserPdfBackend} from '../src/pdfkit-backend.js';
+
+async function backend(){
+ return loadBrowserPdfBackend(async name=>{
+  if(name==='pdfkit')return {PDFDocument:EventEmitter,registerStdFonts(){}};
+  if(name==='svg-to-pdfkit')return {default:()=>{}};
+  if(name==='pdfkit/standard-fonts/Helvetica')return {default:{family:'Helvetica'}};
+  throw Error('UNEXPECTED_IMPORT '+name);
+ });
+}
+
+test('DEV4 internal error abort releases PDFKit byte/end listeners without user cancellation',async()=>{
+ const pdf=new EventEmitter();
+ const api=await backend();
+ const writer=linkPdfWriterAbort(undefined);
+ const pending=api.toBlob(pdf,writer.signal);
+ pdf.emit('data',new Uint8Array(1024));
+ writer.abort();
+ await assert.rejects(pending,e=>e.name==='AbortError');
+ assert.equal(pdf.listenerCount('data'),0);
+ assert.equal(pdf.listenerCount('end'),0);
+ writer.close();
+});
+
+test('DEV4 external user abort propagates to linked writer, but not vice versa',()=>{
+ const user=new AbortController();
+ const writer=linkPdfWriterAbort(user.signal);
+ writer.abort();
+ assert.equal(writer.signal.aborted,true);
+ assert.equal(user.signal.aborted,false);
+ writer.close();
+ const another=linkPdfWriterAbort(user.signal);
+ user.abort();
+ assert.equal(another.signal.aborted,true);
+ another.close();
+});
+
+test('DEV4 already-aborted user signal creates an already-aborted writer signal',()=>{
+ const user=new AbortController();user.abort();
+ const writer=linkPdfWriterAbort(user.signal);
+ assert.equal(writer.signal.aborted,true);
+ writer.close();
+});
+
+test('DEV4 successful PDF stream does not abort the external signal or writer',async()=>{
+ const pdf=new EventEmitter();
+ const api=await backend();
+ const user=new AbortController();
+ const writer=linkPdfWriterAbort(user.signal);
+ const pending=api.toBlob(pdf,writer.signal);
+ pdf.emit('data',new Uint8Array(readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url))));
+ pdf.emit('end');
+ const blob=await pending;
+ assert.ok(blob.size>0);
+ assert.equal(writer.signal.aborted,false);
+ assert.equal(user.signal.aborted,false);
+ writer.close();
+});
+
+test('DEV4 close is idempotent, and previous signal no longer controls writer',()=>{
+ const user=new AbortController();
+ const writer=linkPdfWriterAbort(user.signal);
+ writer.close();writer.close();
+ user.abort();
+ assert.equal(writer.signal.aborted,false);
+});
diff --git a/browser-local/tests/r66-pdf-xref-target.mjs b/browser-local/tests/r66-pdf-xref-target.mjs
new file mode 100644
index 0000000..61e514d
--- /dev/null
+++ b/browser-local/tests/r66-pdf-xref-target.mjs
@@ -0,0 +1,113 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {EventEmitter} from 'node:events';
+import {createPdfOutputGuard,assertCompletePdfBytes} from '../src/pdf-output-integrity.mjs';
+import {loadBrowserPdfBackend} from '../src/pdfkit-backend.js';
+
+const classic=readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url));
+const stream=readFileSync(new URL('./fixtures/r66-xref-stream.pdf',import.meta.url));
+function ptr(b){const m=/startxref\s+(\d+)/.exec(b.toString('latin1'));return Number(m?.[1]);}
+function changedPointer(b,pointer){return Buffer.from(b.toString('latin1').replace(/startxref\s+\d+/,`startxref\n${pointer}`),'latin1');}
+function guardParts(parts){const g=createPdfOutputGuard();for(const part of parts)g.append(part);return g.finish(parts);}
+class StreamPdf extends EventEmitter{destroy(){this.destroyed=true;}}
+async function backend(){return loadBrowserPdfBackend(async name=>{
+ if(name==='pdfkit')return {PDFDocument:StreamPdf,registerStdFonts(){}};
+ if(name==='svg-to-pdfkit')return {default:()=>{}};
+ if(name==='pdfkit/standard-fonts/Helvetica')return {default:{}};
+ throw Error(name);
+});}
+
+test('classic xref points to the actual xref keyword',()=>{
+ assert.equal(guardParts([classic]).xrefKind,'table');
+ assert.equal(assertCompletePdfBytes(classic),classic);
+});
+test('PDF 1.5+ xref stream points to an indirect /Type /XRef object',()=>{
+ assert.equal(guardParts([stream]).xrefKind,'stream');
+ assert.equal(assertCompletePdfBytes(stream),stream);
+});
+test('a valid numeric offset into the PDF header is not accepted',()=>{
+ const bad=changedPointer(classic,12);
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('a valid numeric offset into a PDF body is not accepted for xref-stream fixture',()=>{
+ const bad=changedPointer(stream,100);
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('fake xref stream object without /Type /XRef fails closed',()=>{
+ const bad=Buffer.from(stream);
+ const offset=ptr(bad);const position=bad.indexOf('/Type/XRef',offset,'latin1');
+ assert.ok(position>0);
+ bad.write('/Type/Fake',position,'latin1');
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('xref keyword cannot be a longer fake xref-not-table token',()=>{
+ const bad=Buffer.from(classic);
+ bad.write('xrefX',ptr(bad),'latin1');
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('odd chunk sizes spanning actual xref boundaries are supported',()=>{
+ for(const source of [classic,stream]){
+  const p=ptr(source),splits=[0,8,9,111,p-1,p+1,p+3,source.length-9,source.length];
+  const parts=[];let last=0;
+  for(const n of splits){if(n>last){parts.push(source.subarray(last,n));last=n;}}
+  assert.equal(guardParts(parts).bytes,source.length);
+ }
+});
+test('one-byte chunk streams retain exact absolute xref offset',()=>{
+ const parts=Array.from(classic,x=>Uint8Array.of(x));
+ assert.equal(guardParts(parts).xrefOffset,ptr(classic));
+});
+test('streaming xref source mismatch is rejected, not accepted',()=>{
+ const g=createPdfOutputGuard();g.append(classic);
+ assert.throws(()=>g.finish([classic.subarray(0,-4)]),/PDF_OUTPUT_XREF_SOURCE_MISMATCH/);
+});
+test('no source is rejected instead of silently skipping xref target validation',()=>{
+ const g=createPdfOutputGuard();g.append(classic);
+ assert.throws(()=>g.finish(),/PDF_OUTPUT_XREF_SOURCE_REQUIRED/);
+});
+test('non-Uint8Array source is rejected',()=>{
+ const g=createPdfOutputGuard();g.append(classic);
+ assert.throws(()=>g.finish([null,Buffer.from(classic)]),/PDF_OUTPUT_XREF_SOURCE_MISMATCH/);
+});
+test('the PDFKit browser stream enforces xref validation before returning a Blob',async()=>{
+ const lib=await backend(),s=new StreamPdf();const pending=lib.toBlob(s);
+ s.emit('data',changedPointer(classic,12));s.emit('end');
+ await assert.rejects(pending,/PDF_OUTPUT_XREF_TARGET_INVALID/);
+ assert.equal(s.listenerCount('data'),0);
+});
+test('the PDFKit browser stream supports PDF 1.5+ xref stream chunks',async()=>{
+ const lib=await backend(),s=new StreamPdf();const pending=lib.toBlob(s);
+ for(let pos=0;pos<stream.length;pos+=13)s.emit('data',stream.subarray(pos,pos+13));
+ s.emit('end');const blob=await pending;
+ assert.equal(blob.size,stream.length);
+ assert.deepEqual(Buffer.from(await blob.arrayBuffer()),stream);
+});
+test('output size cap and cancellation protections are unchanged',async()=>{
+ const lib=await backend(),s=new StreamPdf(),pending=lib.toBlob(s,undefined,()=>{},32);
+ s.emit('data',classic);
+ await assert.rejects(pending,/PDF_STREAM_OUTPUT_BYTES_LIMIT/);
+ assert.equal(s.destroyed,true);
+});
+
+test('fake xref table with no valid subsection header is not accepted',()=>{
+ const bad=Buffer.from(classic);
+ bad.write('xref\nA B',ptr(bad),'latin1');
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('xref stream without required /W widths fails closed',()=>{
+ const bad=Buffer.from(stream);
+ const index=bad.indexOf('/W[',ptr(bad),'latin1');assert.ok(index>0);
+ bad.write('/Q[',index,'latin1');
+ assert.throws(()=>assertCompletePdfBytes(bad),/PDF_OUTPUT_XREF_TARGET_INVALID/);
+});
+test('2 MiB payload can be checked at an adjusted xref offset without copying the full payload',()=>{
+ const offset=ptr(classic),filler=Buffer.from('%'+'.'.repeat(1022)+'\n','latin1');
+ const old=Buffer.from(classic.subarray(offset)).toString('latin1');
+ const marker=old.match(/startxref\s+\d+/);assert.ok(marker);
+ const updated=old.replace(/startxref\s+\d+/,`startxref\n${offset+2048*filler.length}`);
+ const payload=Buffer.concat([classic.subarray(0,offset),Buffer.concat(Array(2048).fill(filler)),Buffer.from(updated,'latin1')]);
+ const chunks=[];for(let i=0;i<payload.length;i+=32769)chunks.push(payload.subarray(i,i+32769));
+ assert.equal(guardParts(chunks).bytes,payload.length);
+ assert.equal(assertCompletePdfBytes(payload),payload);
+});
diff --git a/browser-local/tests/r66-raster-watchdog.mjs b/browser-local/tests/r66-raster-watchdog.mjs
new file mode 100644
index 0000000..e2a24fc
--- /dev/null
+++ b/browser-local/tests/r66-raster-watchdog.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {loadSvgRasterImage,encodeSvgRasterPng} from '../src/raster-async-guard.mjs';
+
+class ImageStub {
+  onload=null;onerror=null;removed=0;onSet=null;
+  set src(v){this.value=v;this.onSet?.(v,this);}
+  get src(){return this.value;}
+  removeAttribute(k){if(k==='src'){this.value='';this.removed++;}}
+}
+const wait=ms=>new Promise(resolve=>setTimeout(resolve,ms));
+
+test('successful SVG load retains source for drawImage, then clears handlers',async()=>{
+ const img=new ImageStub();img.onSet=()=>queueMicrotask(()=>img.onload?.());
+ await loadSvgRasterImage(img,'blob:local',null,100);
+ assert.equal(img.src,'blob:local');assert.equal(img.onload,null);assert.equal(img.onerror,null);
+});
+test('SVG load timeout detaches handlers and clears image source',async()=>{
+ const img=new ImageStub();
+ await assert.rejects(loadSvgRasterImage(img,'blob:stuck',null,8),/SVG_RASTER_IMAGE_LOAD_TIMEOUT/);
+ assert.equal(img.removed,1);assert.equal(img.onload,null);assert.equal(img.onerror,null);
+});
+test('SVG image onerror rejects and detaches',async()=>{
+ const img=new ImageStub();img.onSet=()=>queueMicrotask(()=>img.onerror?.());
+ await assert.rejects(loadSvgRasterImage(img,'blob:invalid',null,80),/SVG_RASTER_IMAGE_DECODE_FAILED/);
+ assert.equal(img.removed,1);assert.equal(img.onload,null);
+});
+test('SVG load abort terminates pending await and clears source',async()=>{
+ const c=new AbortController(),img=new ImageStub();const p=loadSvgRasterImage(img,'blob:local',c.signal,100);
+ c.abort();await assert.rejects(p,{name:'AbortError'});assert.equal(img.removed,1);
+});
+test('already-aborted SVG load does not set src',async()=>{
+ const c=new AbortController();c.abort();const img=new ImageStub();
+ await assert.rejects(loadSvgRasterImage(img,'blob:local',c.signal,100),{name:'AbortError'});
+ assert.equal(img.src,'');
+});
+test('image src setter throwing rejects and cleans handlers',async()=>{
+ const img=new ImageStub();img.onSet=()=>{throw Error('SET_FAILED');};
+ await assert.rejects(loadSvgRasterImage(img,'blob:err',null,100),/SET_FAILED/);
+ assert.equal(img.onload,null);
+});
+test('late image event after timeout does not reopen result',async()=>{
+ const img=new ImageStub();const p=loadSvgRasterImage(img,'blob:local',null,7);
+ await assert.rejects(p,/SVG_RASTER_IMAGE_LOAD_TIMEOUT/);
+ img.onload?.();img.onerror?.();assert.equal(img.removed,1);
+});
+test('PNG encoder yields resulting blob and cleans listeners',async()=>{
+ const blob=new Blob(['png'],{type:'image/png'});
+ const returned=await encodeSvgRasterPng({toBlob:(cb,mime)=>{assert.equal(mime,'image/png');cb(blob);}},undefined,100);
+ assert.equal(returned,blob);
+});
+test('PNG toBlob never returns -> bounded timeout',async()=>{
+ await assert.rejects(encodeSvgRasterPng({toBlob:()=>{}},null,8),/SVG_RASTER_PNG_ENCODE_TIMEOUT/);
+});
+test('PNG encoder null result fails, rather than returning invalid PDF preview',async()=>{
+ await assert.rejects(encodeSvgRasterPng({toBlob:cb=>cb(null)},null,80),/SVG_RASTER_PNG_ENCODE_FAILED/);
+});
+test('PNG encoder sync exception is propagated',async()=>{
+ await assert.rejects(encodeSvgRasterPng({toBlob:()=>{throw Error('CANVAS_FAIL');}},null,80),/CANVAS_FAIL/);
+});
+test('PNG encoding abort and late callback are ignored',async()=>{
+ const c=new AbortController();let cb;const p=encodeSvgRasterPng({toBlob:f=>{cb=f;}},c.signal,100);
+ c.abort();await assert.rejects(p,{name:'AbortError'});cb(new Blob(['late']));await wait(1);
+});
+test('already-aborted PNG does not call canvas.toBlob',async()=>{
+ const c=new AbortController();c.abort();let called=false;
+ await assert.rejects(encodeSvgRasterPng({toBlob:()=>{called=true;}},c.signal,100),{name:'AbortError'});
+ assert.equal(called,false);
+});
+test('reject invalid timeout budget (load/encode)',async()=>{
+ assert.throws(()=>loadSvgRasterImage(new ImageStub(),'blob:bad',null,0),/SVG_RASTER_TIMEOUT_INVALID/);
+ assert.throws(()=>encodeSvgRasterPng({toBlob(){}},null,Infinity),/SVG_RASTER_TIMEOUT_INVALID/);
+});
diff --git a/browser-local/tests/r66-spreadsheet-layout.mjs b/browser-local/tests/r66-spreadsheet-layout.mjs
new file mode 100644
index 0000000..6f34dff
--- /dev/null
+++ b/browser-local/tests/r66-spreadsheet-layout.mjs
@@ -0,0 +1,162 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {planSheet,drawSheetPages} from '../src/spreadsheet-pdf.js';
+
+// Use only stable documented SheetJS utils shapes.  This synthetic helper
+// allows identical tests with the real installed SheetJS or offline stubs.
+const letters=c=>{let out='';for(let n=c+1;n>0;n=Math.floor((n-1)/26))out=String.fromCharCode(65+(n-1)%26)+out;return out;};
+const column=s=>[...s].reduce((v,ch)=>v*26+ch.charCodeAt(0)-64,0)-1;
+const cellAddress=address=>{const m=/^([A-Z]+)([1-9][0-9]*)$/.exec(address);if(!m)throw Error('BAD_CELL');return {r:Number(m[2])-1,c:column(m[1])};};
+const xlsx={utils:{
+  decode_range(value){const [s,e=s]=value.split(':');return {s:cellAddress(s),e:cellAddress(e)};},
+  encode_cell({r,c}){return letters(c)+(r+1);},
+  format_cell(cell){return String(cell.w??cell.v??'');}
+}};
+const font={widthOfTextAtSize:(s,size)=>[...s].length*size*.55};
+const range=(a,b)=>({s:cellAddress(a),e:cellAddress(b)});
+const sheet=(ref='A1',text='내용')=>({'!ref':ref,A1:{t:'s',v:text}});
+function finiteLayout(pages){
+  for(const page of pages){
+    assert.ok(page.paper.every(Number.isFinite));
+    assert.ok(page.cols.every(v=>Number.isFinite(v)&&v>0));
+    assert.ok(page.rows.every(v=>Number.isFinite(v)&&v>=0));
+    for(const cell of page.cells){
+      assert.ok(Number.isFinite(cell.width)&&cell.width>0);
+      assert.ok(cell.endC>=cell.c&&cell.endR>=cell.r);
+      assert.ok(cell.endC<page.cols.length&&cell.endR<page.rows.length);
+    }
+  }
+}
+
+test('normal single cell remains one page with finite positions',()=>{
+  const p=planSheet(sheet(),'정상',xlsx,font);
+  assert.equal(p.length,1);assert.equal(p[0].cells[0].lines.join(''),'내용');finiteLayout(p);
+});
+test('merge beyond !ref right edge is fully preserved instead of truncated',()=>{
+  const s=sheet('A1','병합 제목');s['!merges']=[range('A1','C1')];
+  const pages=planSheet(s,'병합',xlsx,font);
+  assert.equal(pages[0].cols.length,3);
+  assert.equal(pages[0].cells[0].endC,2);finiteLayout(pages);
+});
+test('merge beyond !ref lower edge preserves all visible rows',()=>{
+  const s=sheet('A1','세로 병합');s['!merges']=[range('A1','A3')];
+  const pages=planSheet(s,'병합',xlsx,font);
+  assert.equal(pages[0].rows.length,3);
+  assert.equal(pages[0].cells[0].endR,2);finiteLayout(pages);
+});
+test('merge anchor outside stale !ref is not omitted',()=>{
+  const s=sheet('B2:B2');delete s.A1;s.A1={t:'s',v:'외부 병합'};s['!merges']=[range('A1','B2')];
+  const pages=planSheet(s,'병합',xlsx,font);
+  assert.equal(pages[0].cells[0].lines.join(''),'외부 병합');
+  assert.equal(pages[0].cells[0].endC,1);assert.equal(pages[0].cells[0].endR,1);
+});
+test('multiple disjoint merges do not alter existing text or pagination',()=>{
+  const s=sheet('A1:C40','헤더');s.B15={v:'중간'};s.C40={v:'끝'};
+  s['!merges']=[range('A1','B2'),range('B10','C12')];
+  const p=planSheet(s,'표',xlsx,font);finiteLayout(p);
+  const texts=p.flatMap(page=>page.cells.flatMap(c=>c.lines));
+  for(const word of ['헤더','중간','끝'])assert.ok(texts.includes(word),word);
+});
+test('long sheet still paginates without losing rows',()=>{
+  const s=sheet('A1:B100','첫 행');
+  for(let i=2;i<=100;i++)s['A'+i]={v:'행'+i};
+  s['!merges']=[range('A31','A34')];
+  for(let i=32;i<=34;i++)delete s['A'+i];
+  const p=planSheet(s,'긴 표',xlsx,font);finiteLayout(p);
+  assert.ok(p.length>=3);
+  assert.ok(p.some(page=>page.cells.some(c=>c.lines.includes('행31')&&c.endR-c.r===3)));
+  assert.ok(p.flatMap(page=>page.cells.flatMap(c=>c.lines)).includes('행100'));
+});
+test('invalid row height values are rejected before output',()=>{
+  for(const val of [NaN,Infinity,-1,'auto','24',-Infinity]){
+    const s=sheet();s['!rows']=[{hpt:val}];
+    assert.throws(()=>planSheet(s,'행',xlsx,font),/행 높이가 유효하지/,String(val));
+  }
+});
+test('invalid column widths are rejected before output',()=>{
+  for(const val of [NaN,Infinity,-1,'auto','20',-Infinity]){
+    const s=sheet();s['!cols']=[{wch:val}];
+    assert.throws(()=>planSheet(s,'열',xlsx,font),/열 너비가 유효하지/,String(val));
+  }
+});
+test('zero hpt and wch use existing minimum printable geometry',()=>{
+  const s=sheet();s['!rows']=[{hpt:0}];s['!cols']=[{wch:0}];
+  const pages=planSheet(s,'0',xlsx,font);finiteLayout(pages);
+  assert.ok(pages[0].rows[0]>=20&&pages[0].cols[0]>=18);
+});
+test('invalid reversed or fractional merge bounds rejected',()=>{
+  const s=sheet();
+  for(const merge of [range('C1','A2'),range('A3','C1'),
+      {s:{r:0,c:0.3},e:{r:0,c:2}},
+      {s:{r:-1,c:0},e:{r:2,c:2}},
+      {s:{r:0,c:0},e:{r:Infinity,c:1}},
+      null,{s:{r:0,c:0}}]){
+    s['!merges']=[merge];
+    assert.throws(()=>planSheet(s,'병합',xlsx,font),/병합 셀 범위가 유효하지/);
+  }
+});
+test('merge expanding to huge rectangle fails by existing cell budget',()=>{
+  const s=sheet();s['!merges']=[range('A1','XFD1048576')];
+  assert.throws(()=>planSheet(s,'거대병합',xlsx,font),/20만 셀/);
+});
+test('invalid SheetJS !ref indices fail without entering row loops',()=>{
+  for(const bad of ['C3:A1','A1:A1048577','A1:XFE1']){
+    const s=sheet(bad);
+    assert.throws(()=>planSheet(s,'범위',xlsx,font),/셀 범위가 유효하지/);
+  }
+});
+test('preexisting merge overlap rejection remains active',()=>{
+  const s=sheet('A1:C2');s['!merges']=[range('A1','B2'),range('B1','C2')];
+  assert.throws(()=>planSheet(s,'겹침',xlsx,font),/병합 셀이 겹칩니다/);
+});
+test('merge starts hidden remains explicit error',()=>{
+  const s=sheet('A1:B2');s['!merges']=[range('A1','B2')];s['!rows']=[{hidden:true}];
+  assert.throws(()=>planSheet(s,'숨김',xlsx,font),/병합 셀의 시작 위치가 숨겨져/);
+});
+test('empty sheet retains no-page behavior',()=>{
+  assert.deepEqual(planSheet({'!ref':'A1'},'빈표',xlsx,font),[]);
+  assert.deepEqual(planSheet({},'빈표',xlsx,font),[]);
+});
+test('merge range with a visible stored formula without cached value is still rejected',()=>{
+  const s=sheet('A1:B2');s.A1={f:'SUM(B1:B2)',t:'n'};s['!merges']=[range('A1','B2')];
+  assert.throws(()=>planSheet(s,'수식',xlsx,font),/계산값이 없는 수식/);
+});
+
+function fakePdf(){
+ const drawn=[];return {drawn,addPage(paper){
+  const out={paper,rects:[],texts:[],
+   drawRectangle(value){this.rects.push(value);},
+   drawText(text,value){this.texts.push({text,...value});}};
+  drawn.push(out);return out;
+ }};
+}
+test('actual PDF drawing command geometry remains finite and page-bounded',async()=>{
+ const s=sheet('A1:C100','머리');
+ for(let r=2;r<=100;r++)s['A'+r]={v:'행'+r};
+ s['!merges']=[range('A30','B33')];
+ const plan=planSheet(s,'위치검사',xlsx,font);
+ const pdf=fakePdf();const stages=[];
+ const svg=await drawSheetPages(pdf,plan,{},null,p=>stages.push(p));
+ assert.equal(pdf.drawn.length,plan.length);
+ assert.equal(stages.length,plan.length);
+ for(const page of pdf.drawn){
+  for(const rect of page.rects){
+   for(const v of [rect.x,rect.y,rect.width,rect.height])assert.ok(Number.isFinite(v));
+   assert.ok(rect.x>=0&&rect.y>=0);
+   assert.ok(rect.x+rect.width<=page.paper[0]+.001);
+   assert.ok(rect.y+rect.height<=page.paper[1]+.001);
+  }
+  for(const text of page.texts){
+   assert.ok(Number.isFinite(text.x)&&Number.isFinite(text.y));
+   assert.ok(text.x>=0&&text.y>=0&&text.y<=page.paper[1]);
+  }
+ }
+ assert.match(svg,/위치검사/);
+});
+test('SVG preview escapes user cell text but PDF text commands retain characters',async()=>{
+ const s=sheet('A1','<>&"\'');
+ const plan=planSheet(s,'미리보기',xlsx,font);
+ const pdf=fakePdf();const svg=await drawSheetPages(pdf,plan,{},null);
+ assert.ok(svg.includes('&lt;&gt;&amp;&quot;&apos;'));
+ assert.ok(pdf.drawn[0].texts.some(t=>t.text==='<>&"\''));
+});
diff --git a/browser-local/tests/r66-spreadsheet-wrap.mjs b/browser-local/tests/r66-spreadsheet-wrap.mjs
new file mode 100644
index 0000000..abfaa48
--- /dev/null
+++ b/browser-local/tests/r66-spreadsheet-wrap.mjs
@@ -0,0 +1,95 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {wrapSpreadsheetCell} from '../src/spreadsheet-wrap.mjs';
+
+const constantFont={widthOfTextAtSize:(s,size)=>Array.from(s).length*size};
+const tokenFont={widthOfTextAtSize:(s,size)=>{
+  // Simulate a kerning-aware variable advance with a narrow AV pair.
+  return [...s].reduce((sum,c)=>sum+(c==='W'?12:c==='i'?3:8),0)*size/10 -
+    (s.match(/AV/g)||[]).length*(2*size/10);
+}};
+
+function reference(text,width,font,size=9){
+ const out=[];
+ for(const paragraph of String(text).split(/\r\n|\r|\n/)){
+   let line='';
+   for(const c of paragraph){
+    if(font.widthOfTextAtSize(c,size)>width)throw Error('narrow');
+    if(line&&font.widthOfTextAtSize(line+c,size)>width){out.push(line);line='';}
+    line+=c;
+   }
+   out.push(line);
+ }
+ return out;
+}
+test('ordinary ASCII wraps identically to prior algorithm on 70 reference cases',()=>{
+ for(let i=0;i<70;i++){
+  const text='AB WiiiAV'.repeat(2+(i%9));
+  const width=12+i*2;
+  assert.deepEqual(wrapSpreadsheetCell(text,width,tokenFont),reference(text,width,tokenFont));
+ }
+});
+test('empty cells and CRLF, CR, LF preserve original paragraph sequence',()=>{
+ assert.deepEqual(wrapSpreadsheetCell('',80,constantFont),['']);
+ assert.deepEqual(wrapSpreadsheetCell('A\r\n\rB\n\n',10,constantFont,9),['A','','B','','']);
+});
+test('large single line uses logarithmic instead of per-character font measurements',()=>{
+ let calls=0;
+ const font={widthOfTextAtSize:s=>{calls++;return s.length;}};
+ const s='a'.repeat(20_000);
+ assert.deepEqual(wrapSpreadsheetCell(s,20_000,font),[s]);
+ assert.ok(calls<22,'measured '+calls+' runs');
+});
+test('long cell broken across many lines preserves every glyph and never overflows',()=>{
+ const text='abc한글W'.repeat(450);
+ const wrapped=wrapSpreadsheetCell(text,36,constantFont,9);
+ assert.ok(wrapped.length>100);
+ assert.equal(wrapped.join(''),text);
+ assert.ok(wrapped.every(x=>constantFont.widthOfTextAtSize(x,9)<=36));
+});
+test('combining sequence is never split across line boundary',()=>{
+ const s='A'+'e\u0301'+'B';
+ assert.deepEqual(wrapSpreadsheetCell(s,9,{
+  widthOfTextAtSize:t=>[...new Intl.Segmenter('und',{granularity:'grapheme'}).segment(t)].length*9
+ }),['A','e\u0301','B']);
+});
+test('ZWJ emoji and flag regional indicators remain one grapheme each',()=>{
+ const segmenter=new Intl.Segmenter('und',{granularity:'grapheme'});
+ const font={widthOfTextAtSize:t=>[...segmenter.segment(t)].length*10};
+ assert.deepEqual(wrapSpreadsheetCell('a👩‍💻🇰🇷b',10,font),['a','👩‍💻','🇰🇷','b']);
+});
+test('precomposed Korean Hangul syllables are preserved without normalization',()=>{
+ const text='가나다라';
+ assert.deepEqual(wrapSpreadsheetCell(text,18,constantFont),['가나','다라']);
+});
+test('single long grapheme triggers explicit narrow-column failure',()=>{
+ const font={widthOfTextAtSize:()=>50};
+ assert.throws(()=>wrapSpreadsheetCell('🇰🇷',40,font),/열 너비가 글자보다 좁습니다/);
+});
+test('invalid width and font fail before layout',()=>{
+ for(const n of [0,-1,NaN,Infinity]) assert.throws(()=>wrapSpreadsheetCell('A',n,constantFont));
+ assert.throws(()=>wrapSpreadsheetCell('A',10,null),/SHEET_FONT_MEASURE_UNAVAILABLE/);
+});
+test('nondefault font size is forwarded into exact measurements',()=>{
+ const observed=[];
+ const font={widthOfTextAtSize:(s,size)=>{observed.push(size);return s.length*size;}};
+ assert.deepEqual(wrapSpreadsheetCell('ABCD',25,font,12),['AB','CD']);
+ assert.ok(observed.every(v=>v===12));
+});
+test('no Segmenter falls back only for simple text, never splits complex clusters',()=>{
+ const prior=Intl.Segmenter;
+ try{
+  Intl.Segmenter=undefined;
+  assert.deepEqual(wrapSpreadsheetCell('AB',9,constantFont),['A','B']);
+  assert.throws(()=>wrapSpreadsheetCell('e\u0301',10,constantFont),/SHEET_GRAPHEME_SEGMENTER_REQUIRED/);
+  assert.throws(()=>wrapSpreadsheetCell('🇰🇷',10,constantFont),/SHEET_GRAPHEME_SEGMENTER_REQUIRED/);
+  assert.throws(()=>wrapSpreadsheetCell('👋🏽',10,constantFont),/SHEET_GRAPHEME_SEGMENTER_REQUIRED/);
+  assert.throws(()=>wrapSpreadsheetCell('\u1100\u1161',10,constantFont),/SHEET_GRAPHEME_SEGMENTER_REQUIRED/);
+ }finally{Intl.Segmenter=prior;}
+});
+test('output is deterministic across repeated calls and contains no injected glyphs',()=>{
+ const input='서울★경기\n부산';
+ const a=wrapSpreadsheetCell(input,27,constantFont),b=wrapSpreadsheetCell(input,27,constantFont);
+ assert.deepEqual(a,b);
+ assert.equal(a.join(''),'서울★경기부산');
+});
diff --git a/browser-local/tests/r66-svg-vector-budget.mjs b/browser-local/tests/r66-svg-vector-budget.mjs
new file mode 100644
index 0000000..ba2b6b6
--- /dev/null
+++ b/browser-local/tests/r66-svg-vector-budget.mjs
@@ -0,0 +1,73 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {createSvgVectorBudget,SVG_VECTOR_BUDGET} from '../src/svg-vector-budget.mjs';
+const path=d=>({localName:'path',getAttribute:key=>key==='d'?d:null});
+const poly=(type,points)=>({localName:type,getAttribute:key=>key==='points'?points:null});
+const text=()=>({localName:'text',getAttribute:()=>null});
+
+test('normal HWP paths and SVG text remain eligible',()=>{
+  const v=createSvgVectorBudget();
+  assert.equal(v.element(path('M0 0 L10 20 C1 2 3 4 5 6 Z')),null);
+  assert.equal(v.element(poly('polygon','0,0 20,0 20,20')),null);
+  assert.equal(v.text('환경영향평가 내용 · 표 A/B'),null);
+  assert.deepEqual(v.totals,{pathChars:26,commands:4,pointsChars:14,textChars:17});
+});
+test('path command counter does not confuse numeric exponent with command',()=>{
+  const v=createSvgVectorBudget();
+  assert.equal(v.element(path('M1e-5 2E5 l1.2e-3 4.5')),null);
+  assert.equal(v.totals.commands,2);
+});
+test('large single path is rejected before synchronous PDFKit',()=>{
+  const v=createSvgVectorBudget();
+  assert.equal(v.element(path('M'+ '0'.repeat(SVG_VECTOR_BUDGET.pathSingle))), 'SVG_VECTOR_PATH_BUDGET');
+});
+test('path length exact limit allowed, next char denied',()=>{
+  const v=createSvgVectorBudget({ ...SVG_VECTOR_BUDGET,pathSingle:10,pathTotal:100 });
+  assert.equal(v.element(path('M'+ '0'.repeat(9))),null);
+  assert.equal(v.element(path('M'+ '0'.repeat(10))),'SVG_VECTOR_PATH_BUDGET');
+});
+test('path sum is bounded even when individual paths fit',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,pathSingle:10,pathTotal:14});
+  assert.equal(v.element(path('M0 1 2 3')),null);
+  assert.equal(v.element(path('M1 2 3 4')),'SVG_VECTOR_PATH_BUDGET');
+});
+test('path command budget guards many tiny operations',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,commandsSingle:3,commandsTotal:5});
+  assert.equal(v.element(path('M0L1L2L3')),'SVG_VECTOR_COMMAND_BUDGET');
+});
+test('aggregate path commands guard many small paths',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,commandsSingle:10,commandsTotal:3});
+  assert.equal(v.element(path('M0L1')),null);
+  assert.equal(v.element(path('M1L2')),'SVG_VECTOR_COMMAND_BUDGET');
+});
+test('complex polyline limit applies',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,pointsSingle:5});
+  assert.equal(v.element(poly('polyline','0 0 1 2')),'SVG_VECTOR_POINTS_BUDGET');
+});
+test('polygons and polylines share aggregate point budget',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,pointsSingle:100,pointsTotal:8});
+  assert.equal(v.element(poly('polygon','0 0 1')),null);
+  assert.equal(v.element(poly('polyline','2 2 3')),'SVG_VECTOR_POINTS_BUDGET');
+});
+test('one long text run is rejected before font lookup',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,textSingle:4});
+  assert.equal(v.text('평가서'),null);
+  assert.equal(v.text('환경영향평가'),'SVG_VECTOR_TEXT_BUDGET');
+});
+test('aggregate text budget counts multiple tspan runs',()=>{
+  const v=createSvgVectorBudget({...SVG_VECTOR_BUDGET,textSingle:100,textTotal:5});
+  assert.equal(v.text('abc'),null);
+  assert.equal(v.text('def'),'SVG_VECTOR_TEXT_BUDGET');
+});
+test('non-path geometry untouched and counters unchanged',()=>{
+  const v=createSvgVectorBudget();
+  assert.equal(v.element(text()),null);
+  assert.equal(v.element({localName:'rect',getAttribute:()=> 'not-path'}),null);
+  assert.equal(v.element(null),null);
+  assert.deepEqual(v.totals,{pathChars:0,commands:0,pointsChars:0,textChars:0});
+});
+test('oversized geometric input fails by a stable machine-readable reason',()=>{
+  const v=createSvgVectorBudget();
+  const err=v.element(path('M'+ 'L0'.repeat(150001)));
+  assert.equal(err,'SVG_VECTOR_COMMAND_BUDGET');
+});
diff --git a/browser-local/tests/r66-sync-render-guard.mjs b/browser-local/tests/r66-sync-render-guard.mjs
new file mode 100644
index 0000000..555673d
--- /dev/null
+++ b/browser-local/tests/r66-sync-render-guard.mjs
@@ -0,0 +1,76 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {EventEmitter} from 'node:events';
+import {readFileSync} from 'node:fs';
+const validPdf=readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url));
+import {assertSvgSourceWithinBudget,checkSvgPathBudget} from '../src/svg-render-guard.mjs';
+import {loadBrowserPdfBackend} from '../src/pdfkit-backend.js';
+
+const path=(d)=>({localName:'path',getAttribute:(name)=>name==='d'?d:null});
+const rect={localName:'rect',getAttribute:()=>null};
+
+// The size guard is an admission check, not an XML sanitizer.
+test('R66-DEV3 source budget accepts source at the boundary',()=>{
+ assert.equal(assertSvgSourceWithinBudget('<svg/>',{maxChars:6}),6);
+});
+test('R66-DEV3 rejects oversized SVG before DOM/parser/vector renderer',()=>{
+ assert.throws(()=>assertSvgSourceWithinBudget('<svg/>!',{maxChars:6}),/SVG_RENDER_SOURCE_CHARS_LIMIT/);
+});
+test('R66-DEV3 rejects invalid source and bad limits',()=>{
+ assert.throws(()=>assertSvgSourceWithinBudget(null),/SVG_RENDER_INPUT_INVALID/);
+ assert.throws(()=>assertSvgSourceWithinBudget('x',{maxChars:0}),/SVG_RENDER_BUDGET_INVALID/);
+});
+test('R66-DEV3 per-path limit cannot silently truncate geometry',()=>{
+ assert.deepEqual(checkSvgPathBudget(path('abcde'),0,{maxSinglePath:4,maxPagePaths:8}),
+  {ok:false,reason:'SVG_RENDER_SINGLE_PATH_LIMIT'});
+});
+test('R66-DEV3 aggregate path budget counts every SVG path',()=>{
+ const opts={maxSinglePath:4,maxPagePaths:7};
+ const a=checkSvgPathBudget(path('aaaa'),0,opts);
+ assert.deepEqual(a,{ok:true,total:4});
+ assert.deepEqual(checkSvgPathBudget(path('bbb'),a.total,opts),{ok:true,total:7});
+ assert.deepEqual(checkSvgPathBudget(path('c'),7,opts),{ok:false,reason:'SVG_RENDER_PAGE_PATH_LIMIT'});
+});
+test('R66-DEV3 non-path SVG objects do not alter vector budget',()=>{
+ assert.deepEqual(checkSvgPathBudget(rect,5,{maxSinglePath:8,maxPagePaths:12}),{ok:true,total:5});
+});
+test('R66-DEV3 invalid budget is explicitly rejected',()=>{
+ assert.equal(checkSvgPathBudget(path(''),-1).reason,'SVG_RENDER_BUDGET_INVALID');
+});
+
+class StubPdf extends EventEmitter { destroy(){this.destroyed=true;} }
+async function backend(){return loadBrowserPdfBackend(async name=>{
+ if(name==='pdfkit')return {PDFDocument:StubPdf,registerStdFonts(){}};
+ if(name==='svg-to-pdfkit')return {default:()=>{}};
+ if(name==='pdfkit/standard-fonts/Helvetica')return {default:{family:'Helvetica'}};
+ throw Error('UNEXPECTED_IMPORT');
+});}
+
+test('R66-DEV3 PDFKit byte ceiling rejects before retaining oversized output',async()=>{
+ const api=await backend(),pdf=new StubPdf();
+ const pending=api.toBlob(pdf,undefined,()=>{},10);
+ pdf.emit('data',new Uint8Array(9));
+ pdf.emit('data',new Uint8Array(2));
+ await assert.rejects(pending,/PDF_STREAM_OUTPUT_BYTES_LIMIT/);
+ assert.equal(pdf.destroyed,true);
+ assert.equal(pdf.listenerCount('data'),0);
+});
+test('R66-DEV3 PDFKit byte ceiling accepts exact boundary',async()=>{
+ const api=await backend(),pdf=new StubPdf();
+ const pending=api.toBlob(pdf,undefined,()=>{},validPdf.length);
+ pdf.emit('data',validPdf.subarray(0,5));pdf.emit('data',validPdf.subarray(5));pdf.emit('end');
+ assert.equal((await pending).size,validPdf.length);
+});
+test('R66-DEV3 PDFKit invalid ceiling fails before any listeners are set',async()=>{
+ const api=await backend(),pdf=new StubPdf();
+ await assert.rejects(api.toBlob(pdf,undefined,()=>{},0),/PDF_STREAM_BUDGET_INVALID/);
+ assert.equal(pdf.listenerCount('data'),0);
+});
+test('R66-DEV3 PDFKit late data after budget breach is ignored',async()=>{
+ const api=await backend(),pdf=new StubPdf();
+ const pending=api.toBlob(pdf,undefined,()=>{},10);
+ pdf.emit('data',new Uint8Array(11));
+ await assert.rejects(pending,/PDF_STREAM_OUTPUT_BYTES_LIMIT/);
+ pdf.emit('data',new Uint8Array(11));pdf.emit('end');
+ assert.equal(pdf.listenerCount('end'),0);
+});
diff --git a/browser-local/tests/r66-xlsx-package-guard.mjs b/browser-local/tests/r66-xlsx-package-guard.mjs
new file mode 100644
index 0000000..7f8e16c
--- /dev/null
+++ b/browser-local/tests/r66-xlsx-package-guard.mjs
@@ -0,0 +1,80 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {inspectXlsxPackage,XLSX_LIMITS} from '../src/xlsx-package-guard.mjs';
+const fixture=name=>new Uint8Array(readFileSync(new URL('./fixtures/'+name,import.meta.url)));
+const err=(data,pattern)=>assert.throws(()=>inspectXlsxPackage(data),pattern);
+const clone=x=>Uint8Array.from(x);
+function eocdPos(b){for(let i=b.length-22;i>=0;i--)if(b[i]===80&&b[i+1]===75&&b[i+2]===5&&b[i+3]===6)return i;throw Error('missing EOCD');}
+function firstCentral(b){const dv=new DataView(b.buffer,b.byteOffset,b.byteLength);return dv.getUint32(eocdPos(b)+16,true);}
+function view(b){return new DataView(b.buffer,b.byteOffset,b.byteLength);}
+
+test('real Python-generated XLSX ZIP parts and directory entry pass bounded metadata check',()=>{
+ const r=inspectXlsxPackage(fixture('small-real-zip.xlsx'));
+ assert.ok(r.entryCount>=3);assert.ok(r.expandedBytes>0);
+});
+test('deflated XLSX with common OOXML content-type and workbook paths passes',()=>{
+ const r=inspectXlsxPackage(fixture('small-deflated.xlsx'));assert.ok(r.compressedBytes>0);
+});
+test('random bytes, truncated file and renamed non-Office ZIP are rejected',()=>{
+ for(const bytes of [new Uint8Array(24),fixture('non-office.zip'),fixture('small-deflated.xlsx').slice(0,64)])
+  assert.throws(()=>inspectXlsxPackage(bytes),/XLSX_/);
+});
+test('upper bound on input archive bytes before central parser',()=>{
+ assert.throws(()=>inspectXlsxPackage(fixture('small-deflated.xlsx'),{...XLSX_LIMITS,inputBytes:32}),/XLSX_INPUT_BYTES_LIMIT/);
+});
+test('central total expanded-byte budget blocks forged oversized uncompressed size',()=>{
+ const bytes=clone(fixture('small-deflated.xlsx')),dv=view(bytes),p=firstCentral(bytes);
+ dv.setUint32(p+24,0x02000000,true);
+ assert.throws(()=>inspectXlsxPackage(bytes,{...XLSX_LIMITS,entryBytes:0x04000000,totalExpandedBytes:0x01000000}),/XLSX_ZIP_(?:EXPANDED_BYTES|COMPRESSION_RATIO)_LIMIT/);
+});
+test('central entry expanded cap catches large declared entry',()=>{
+ const b=clone(fixture('small-deflated.xlsx')),p=firstCentral(b);
+ view(b).setUint32(p+24,XLSX_LIMITS.entryBytes+1,true);
+ err(b,/XLSX_ZIP_ENTRY_BYTES_LIMIT/);
+});
+test('entry count cap prevents excessive ZIP traversal',()=>{
+ const b=fixture('small-deflated.xlsx');
+ assert.throws(()=>inspectXlsxPackage(b,{...XLSX_LIMITS,entries:1}),/XLSX_ZIP_ENTRY_COUNT_LIMIT/);
+});
+test('ZIP64 sentinel and encrypted entry are rejected',()=>{
+ const base=fixture('small-deflated.xlsx');
+ const a=clone(base);view(a).setUint16(eocdPos(a)+10,0xffff,true);err(a,/XLSX_ZIP64_UNSUPPORTED/);
+ const b=clone(base),p=firstCentral(b);view(b).setUint16(p+8,1,true);err(b,/XLSX_ZIP_ENCRYPTED_UNSUPPORTED/);
+});
+test('traversal paths, backslashes and absolute names are rejected',()=>{
+ for(const name of ['../xl/a.xml','xl\\workbook','/xl/evil']){
+  const b=clone(fixture('small-deflated.xlsx')),p=firstCentral(b),nameBytes=new TextEncoder().encode(name);
+  const max=view(b).getUint16(p+28,true);
+  // Edit only an existing long enough path to avoid corrupting other fields.
+  if(nameBytes.length>max)continue;
+  b.set(nameBytes,p+46);
+  err(b,/XLSX_ZIP_ENTRY_NAME_INVALID|XLSX_ZIP_LOCAL_HEADER_MISMATCH/);
+ }
+});
+test('invalid central directory offsets and local data bounds are rejected',()=>{
+ const a=clone(fixture('small-deflated.xlsx'));view(a).setUint32(eocdPos(a)+16,0,true);
+ err(a,/XLSX_ZIP_CENTRAL_DIRECTORY_INVALID/);
+ const b=clone(fixture('small-deflated.xlsx'));view(b).setUint32(firstCentral(b)+42,0x7fffffff,true);
+ err(b,/XLSX_ZIP_LOCAL_HEADER_INVALID/);
+});
+test('inconsistency between central directory and local header is rejected',()=>{
+ const b=clone(fixture('small-deflated.xlsx')),p=firstCentral(b),dv=view(b);
+ dv.setUint16(p+10,0,true);
+ err(b,/XLSX_ZIP_LOCAL_HEADER_MISMATCH/);
+});
+test('compressed bomb by ratio detected independently of file byte budget',()=>{
+ const b=clone(fixture('small-deflated.xlsx')),p=firstCentral(b),dv=view(b);
+ dv.setUint32(p+20,1,true);dv.setUint32(p+24,1000000,true);
+ err(b,/XLSX_ZIP_COMPRESSION_RATIO_LIMIT/);
+});
+test('reject symlink and special-file entries advertised by Unix mode',()=>{
+ const b=clone(fixture('small-deflated.xlsx')),p=firstCentral(b),dv=view(b);
+ dv.setUint8(p+5,3);dv.setUint32(p+38,0o120777<<16,true);
+ err(b,/XLSX_ZIP_SPECIAL_FILE_UNSUPPORTED/);
+});
+
+test('canonical minimal OOXML workbook fixture with relationships is accepted',()=>{
+ const result=inspectXlsxPackage(fixture('xlsx-canonical.xlsx'));
+ assert.equal(result.entryCount,5);assert.ok(result.expandedBytes>500);
+});
diff --git a/browser-local/tests/r66-xlsx-structure-extra.mjs b/browser-local/tests/r66-xlsx-structure-extra.mjs
