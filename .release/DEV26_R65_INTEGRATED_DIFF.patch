index 0000000..b3a94d4
--- /dev/null
+++ b/browser-local/src/svg-render-guard.mjs
@@ -0,0 +1,32 @@
+/** R66-DEV3: conservative, pre-render resource guards.
+ * No SVG parsing or rewriting here. The existing sanitizer remains authoritative.
+ * These checks fail closed before especially expensive synchronous PDFKit work.
+ */
+export const MAX_SVG_SOURCE_CHARS = 64 * 1024 * 1024;
+export const MAX_SINGLE_PATH_CHARS = 2 * 1024 * 1024;
+export const MAX_PAGE_PATH_CHARS = 8 * 1024 * 1024;
+
+export function assertSvgSourceWithinBudget(source,{maxChars=MAX_SVG_SOURCE_CHARS}={}){
+  if(typeof source!=='string')throw Error('SVG_RENDER_INPUT_INVALID');
+  if(!Number.isSafeInteger(maxChars)||maxChars<1)throw Error('SVG_RENDER_BUDGET_INVALID');
+  if(source.length>maxChars)throw Error('SVG_RENDER_SOURCE_CHARS_LIMIT');
+  return source.length;
+}
+
+/** Called as SVG elements are already traversed in the existing preflight.
+ * Returns failure rather than silently truncating vector path geometry.
+ */
+export function checkSvgPathBudget(el,total=0,{
+  maxSinglePath=MAX_SINGLE_PATH_CHARS,maxPagePaths=MAX_PAGE_PATH_CHARS
+}={}){
+  if(!Number.isSafeInteger(total)||total<0||
+     !Number.isSafeInteger(maxSinglePath)||maxSinglePath<1||
+     !Number.isSafeInteger(maxPagePaths)||maxPagePaths<maxSinglePath)
+    return {ok:false,reason:'SVG_RENDER_BUDGET_INVALID'};
+  if(el?.localName!=='path')return {ok:true,total};
+  const d=el.getAttribute?.('d');
+  const size=typeof d==='string'?d.length:0;
+  if(size>maxSinglePath)return {ok:false,reason:'SVG_RENDER_SINGLE_PATH_LIMIT'};
+  if(size>maxPagePaths-total)return {ok:false,reason:'SVG_RENDER_PAGE_PATH_LIMIT'};
+  return {ok:true,total:total+size};
+}
diff --git a/browser-local/src/svg-vector-budget.mjs b/browser-local/src/svg-vector-budget.mjs
new file mode 100644
index 0000000..23a8c17
--- /dev/null
+++ b/browser-local/src/svg-vector-budget.mjs
@@ -0,0 +1,56 @@
+/** R66 DEV26: bounded per-page SVG vector complexity before synchronous SVGtoPDF.
+ * The checker never changes geometry, text, fonts, or embedded images.
+ * It is a fail-closed preflight guard, NOT a way to interrupt a synchronous WASM
+ * or SVGtoPDF call that has already begun. No new network or DOM dependencies.
+ */
+export const SVG_VECTOR_BUDGET = Object.freeze({
+  pathSingle: 2_000_000,
+  pathTotal: 12_000_000,
+  commandsSingle: 150_000,
+  commandsTotal: 300_000,
+  pointsSingle: 2_000_000,
+  pointsTotal: 8_000_000,
+  textSingle: 500_000,
+  textTotal: 2_000_000,
+});
+
+function isCommand(charCode) {
+  // SVG path commands, ASCII only. Does not count exponent 'e' as command.
+  return charCode===65||charCode===67||charCode===72||charCode===76||
+    charCode===77||charCode===81||charCode===83||charCode===84||
+    charCode===86||charCode===90||charCode===97||charCode===99||
+    charCode===104||charCode===108||charCode===109||charCode===113||
+    charCode===115||charCode===116||charCode===118||charCode===122;
+}
+
+export function createSvgVectorBudget(limits=SVG_VECTOR_BUDGET){
+  let pathChars=0,commands=0,pointsChars=0,textChars=0;
+  // Avoid regex match arrays and do not cache or copy potentially huge path strings.
+  function element(el){
+    const tag=el?.localName;
+    if(tag==='path'){
+      const d=el.getAttribute('d')||'';
+      if(d.length>limits.pathSingle || (pathChars+=d.length)>limits.pathTotal)
+        return 'SVG_VECTOR_PATH_BUDGET';
+      let count=0;
+      for(let i=0;i<d.length;i++){
+        if(isCommand(d.charCodeAt(i)) && ++count>limits.commandsSingle)
+          return 'SVG_VECTOR_COMMAND_BUDGET';
+      }
+      commands+=count;
+      if(commands>limits.commandsTotal)return 'SVG_VECTOR_COMMAND_BUDGET';
+    }else if(tag==='polyline'||tag==='polygon'){
+      const data=el.getAttribute('points')||'';
+      if(data.length>limits.pointsSingle || (pointsChars+=data.length)>limits.pointsTotal)
+        return 'SVG_VECTOR_POINTS_BUDGET';
+    }
+    return null;
+  }
+  function text(value){
+    const length=String(value).length;
+    if(length>limits.textSingle || (textChars+=length)>limits.textTotal)
+      return 'SVG_VECTOR_TEXT_BUDGET';
+    return null;
+  }
+  return {element,text,get totals(){return {pathChars,commands,pointsChars,textChars};}};
+}
