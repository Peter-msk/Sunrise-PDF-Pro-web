diff --git a/browser-local/tests/r66-real-failure-retry.mjs b/browser-local/tests/r66-real-failure-retry.mjs
new file mode 100644
index 0000000..66f174f
--- /dev/null
+++ b/browser-local/tests/r66-real-failure-retry.mjs
@@ -0,0 +1,72 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {canRecoverFile,planConversion,recoveryCode} from '../src/conversion-recovery.mjs';
+const failed=(name,error,engine='professional')=>({file:{name},error,state:'failed',lastEngine:engine});
+const pending=(name)=>({file:{name},state:'ready'});
+const done=(name)=>({file:{name},state:'done'});
+
+test('real SVG filter error offers explicit one-file recovery',()=>{
+ const x=failed('문서.hwp','1쪽 출력 실패 (SVG_FILTER_EFFECT_UNSUPPORTED)');
+ assert.equal(recoveryCode(x.error),'SVG_FILTER_EFFECT_UNSUPPORTED');
+ assert.equal(canRecoverFile(x),true);
+ const other=pending('기다리는문서.hwpx'),finished=done('완료된문서.hwp');
+ const plan=planConversion([finished,other,x],'professional',x);
+ assert.equal(plan.recovery,true);assert.equal(plan.engine,'compat-raster');
+ assert.equal(plan.cause,'SVG_FILTER_EFFECT_UNSUPPORTED');assert.deepEqual(plan.pending,[x]);
+});
+
+test('real PDFKit EOF stall offers explicit one-file recovery',()=>{
+ const x=failed('문서.HWPX','PDF_STREAM_TIMEOUT');
+ const plan=planConversion([x,pending('표.xlsx')],'professional',x);
+ assert.equal(plan.pending.length,1);assert.strictEqual(plan.pending[0],x);
+ assert.equal(plan.engine,'compat-raster');assert.equal(plan.cause,'PDF_STREAM_TIMEOUT');
+});
+
+test('no implicit raster downgrade after a failure',()=>{
+ const x=failed('문서.hwp','SVG_FILTER_EFFECT_UNSUPPORTED');
+ const y=pending('다음.hwp');
+ const plan=planConversion([x,y],'professional');
+ assert.equal(plan.recovery,false);assert.equal(plan.engine,'professional');
+ assert.deepEqual(plan.pending,[x,y]);
+});
+
+test('do not expose recovery for non-HWP formats or unsupported failures',()=>{
+ assert.equal(canRecoverFile(failed('표.xlsx','PDF_STREAM_TIMEOUT')),false);
+ assert.equal(canRecoverFile(failed('문서.hwp','FONT_FAMILY_OR_VARIANT_UNAVAILABLE')),false);
+ assert.equal(canRecoverFile(failed('문서.hwp','PDF_STREAM_TIMEOUT','compat-raster')),false);
+ assert.equal(canRecoverFile({...failed('문서.hwp','PDF_STREAM_TIMEOUT'),state:'done'}),false);
+ assert.equal(canRecoverFile(failed('문서.hwp','PREFIX_PDF_STREAM_TIMEOUT_EXTRA')),false);
+});
+
+test('stale or unapproved retry target cannot switch conversion engine',()=>{
+ const x=failed('문서.hwp','PDF_STREAM_TIMEOUT');
+ const plan=planConversion([pending('다음.hwp')],'professional',x);
+ assert.equal(plan.recovery,false);assert.equal(plan.engine,'professional');
+ assert.deepEqual(plan.pending,[]);
+});
+
+test('explicitly chosen compatibility for full batch remains supported',()=>{
+ const x=pending('문서.hwp'),y=pending('표.xlsx');
+ const plan=planConversion([x,y],'compat-raster');
+ assert.equal(plan.recovery,false);assert.equal(plan.engine,'compat-raster');
+ assert.equal(plan.pending.length,2);
+});
+
+test('UI uses the plan for exactly one retry without changing global option',()=>{
+ const src=readFileSync(new URL('../src/main.js',import.meta.url),'utf8');
+ const html=readFileSync(new URL('../index.html',import.meta.url),'utf8');
+ assert.match(src,/requestedFileRecovery=item;/);
+ assert.match(src,/planConversion\(items,\$\('pdf-engine'\)\.value,requested\)/);
+ assert.match(src,/const \{pending,engine\}=plan/);
+ assert.match(src,/item\.lastEngine=engine/);
+ assert.match(src,/requested\?\.state==='done'\?requested/);
+ assert.match(src,/plan\.recovery&&item===requested/);
+ assert.match(html,/<option value="professional" selected>/);
+ assert.match(html,/compat-retry/);
+ assert.doesNotMatch(src,/\$\('pdf-engine'\)\.value='compat-raster'/);
+});
+
+test('reject malformed queue rather than retaining stale state',()=>{
+ assert.throws(()=>planConversion(null,'professional'),/CONVERSION_QUEUE_INVALID/);
+});
diff --git a/browser-local/tests/recovery-browser.mjs b/browser-local/tests/recovery-browser.mjs
new file mode 100644
index 0000000..f25405a
--- /dev/null
+++ b/browser-local/tests/recovery-browser.mjs
@@ -0,0 +1,62 @@
+/**
+ * Browser-level deterministic regression for production error recovery.
+ * Inject only the conversion boundary at Vite dev URL. All queue, DOM, batch,
+ * event, and per-file restart code is the real application, not a replica.
+ * The HWP/HWPX source bytes remain in the browser and no admin data is read.
+ */
+import {chromium} from 'playwright';
+import {readFileSync} from 'node:fs';
+import assert from 'node:assert/strict';
+const url=process.env.SUNRISE_RECOVERY_UI_URL||'http://127.0.0.1:4174/';
+const pdfBytes=Array.from(readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url)));
+const browser=await chromium.launch({headless:true,args:['--no-sandbox']});
+try{
+ const page=await browser.newPage({acceptDownloads:true});
+ const pageErrors=[];
+ page.on('pageerror',error=>pageErrors.push(error.message));
+ await page.addInitScript(bytes=>{window.__recoveryTestPdf=bytes;},pdfBytes);
+ let injected=0;
+ await page.route('**/src/convert-any.js*',async route=>{
+  injected++;
+  await route.fulfill({status:200,contentType:'application/javascript',body:`
+   export async function convertAnyToPdf(file,onProgress=()=>{},signal,options={}) {
+    if(signal?.aborted)throw new DOMException('cancelled','AbortError');
+    const mode=options.engine||'professional';
+    onProgress({stage:'professional',detail:mode==='professional'?'svg_vector':'compat_raster',page:1,total:1});
+    if(mode==='professional'&&file.name==='filter.hwp')throw Error('SVG_FILTER_EFFECT_UNSUPPORTED');
+    if(mode==='professional'&&file.name==='stream.hwpx')throw Error('PDF_STREAM_TIMEOUT');
+    const raw=new Uint8Array(window.__recoveryTestPdf);
+    return {pdf:new Blob([raw],{type:'application/pdf'}),pages:1,bytes:raw.byteLength,
+      renderMode:mode==='professional'?'professional':'raster-compat',warnings:[]};
+   }
+  `});
+ });
+ await page.goto(url,{waitUntil:'networkidle',timeout:45000});
+ await page.waitForFunction(()=>document.getElementById('status')?.textContent?.includes('변환 준비 완료'),null,{timeout:30000});
+ assert.equal(injected,1,'The browser must execute the isolated test converter');
+ await page.locator('#source').setInputFiles([
+  {name:'filter.hwp',mimeType:'application/octet-stream',buffer:Buffer.alloc(20,7)},
+  {name:'stream.hwpx',mimeType:'application/octet-stream',buffer:Buffer.alloc(20,8)},
+  {name:'completed.xlsx',mimeType:'application/octet-stream',buffer:Buffer.alloc(20,9)}
+ ]);
+ await page.locator('#convert').click();
+ await page.waitForFunction(()=>document.getElementById('done-count')?.textContent==='1'&&document.getElementById('failed-count')?.textContent==='2'&&document.getElementById('cancel')?.disabled,null,{timeout:35000});
+ assert.equal(await page.locator('.compat-retry').count(),2);
+ assert.equal(await page.locator('#pdf-engine').inputValue(),'professional');
+ assert.match(await page.locator('#file-list').innerText(),/SVG_FILTER_EFFECT_UNSUPPORTED/);
+ assert.match(await page.locator('#file-list').innerText(),/PDF_STREAM_TIMEOUT/);
+ const filterRow=page.locator('.file-row').filter({hasText:'filter.hwp'});
+ await filterRow.locator('.compat-retry').click();
+ await page.waitForFunction(()=>document.getElementById('done-count')?.textContent==='2'&&document.getElementById('failed-count')?.textContent==='1'&&document.getElementById('cancel')?.disabled,null,{timeout:35000});
+ assert.equal(await page.locator('#pdf-engine').inputValue(),'professional','global default must remain vector');
+ assert.match(await page.locator('.file-row').filter({hasText:'completed.xlsx'}).innerText(),/변환 완료/);
+ assert.match(await page.locator('.file-row').filter({hasText:'stream.hwpx'}).innerText(),/PDF_STREAM_TIMEOUT/);
+ assert.match(await filterRow.innerText(),/변환 완료/);
+ assert.equal(await page.locator('.compat-retry').count(),1);
+ await page.locator('.file-row').filter({hasText:'stream.hwpx'}).locator('.compat-retry').click();
+ await page.waitForFunction(()=>document.getElementById('done-count')?.textContent==='3'&&document.getElementById('failed-count')?.textContent==='0'&&document.getElementById('cancel')?.disabled,null,{timeout:35000});
+ assert.equal(await page.locator('.compat-retry').count(),0);
+ assert.equal(await page.locator('#pdf-engine').inputValue(),'professional');
+ assert.deepEqual(pageErrors,[],'no uncaught UI errors');
+ console.log('RECOVERY_BROWSER_REAL_UI_PASS: both real error classes recovered individually; successful queue items untouched; vector remains default');
+}finally{await browser.close();}
