+ * and browser-rendered pages so unsupported SVG filter effects remain visible.
+ *
+ * This output is page images, not selectable/vector text. Never call this from
+ * the professional path as an automatic fallback or claim fidelity equivalence.
+ * No file bytes are uploaded to the server.
+ */
+import {assertCompletePdfBytes} from './pdf-output-integrity.mjs';
+import {waitForImageOperation} from './svg-safe-grayscale.mjs';
+
+const MAX_PAGES=120;
+const MAX_OUTPUT_BYTES=512*1024*1024;
+const PDF_SAVE_TIMEOUT_MS=120_000;
+const cancelled=signal=>{
+ if(signal?.aborted)throw new DOMException('호환 PDF 변환이 취소되었습니다.','AbortError');
+};
+
+export async function buildRasterCompatibilityPdf(hwpDoc,count,{
+ signal,onProgress=()=>{},preprocessSvg,rasterPage,
+ loadPdfLib=()=>import('pdf-lib')
+}={}){
+ if(!Number.isSafeInteger(count)||count<1||count>MAX_PAGES)
+  throw Error('COMPAT_PAGE_COUNT_INVALID');
+ if(typeof hwpDoc?.renderPageSvgWithProfile!=='function'||
+    typeof preprocessSvg!=='function'||typeof rasterPage!=='function')
+  throw Error('COMPAT_RENDERER_UNAVAILABLE');
+ cancelled(signal);
+ const library=await loadPdfLib();
+ if(typeof library?.PDFDocument?.create!=='function')throw Error('COMPAT_PDF_DEPENDENCY_UNAVAILABLE');
+ const pdf=await library.PDFDocument.create();
+ cancelled(signal);
+ for(let i=0;i<count;i++){
+  cancelled(signal);
+  const page=i+1;
+  onProgress({stage:'professional',detail:'svg_build',page,total:count});
+  // rhwp is synchronous. Yield before the WASM call, without claiming that
+  // cancellation can interrupt a synchronous SVG render already in progress.
+  await new Promise(resolve=>setTimeout(resolve,0));cancelled(signal);
+  const svg=hwpDoc.renderPageSvgWithProfile(i,'print');
+  onProgress({stage:'professional',detail:'image_filter',page,total:count});
+  const checked=await preprocessSvg(svg,page,count);
+  cancelled(signal);
+  onProgress({stage:'professional',detail:'compat_raster',page,total:count});
+  // SVG filters are rendered by Chromium's SVG engine, not discarded or
+  // approximated by PDFKit. rasterPage enforces the per-page pixel budget.
+  const image=await rasterPage(checked,signal);
+  cancelled(signal);
+  if(!(image?.blob instanceof Blob)||image.blob.type!=='image/png'||
+    !Number.isFinite(image.widthPt)||!Number.isFinite(image.heightPt)||
+    image.widthPt<=0||image.heightPt<=0||image.widthPt>20000||image.heightPt>20000)
+   throw Error('COMPAT_PAGE_IMAGE_INVALID');
+  const bytes=new Uint8Array(await image.blob.arrayBuffer());
+  cancelled(signal);
+  const png=await pdf.embedPng(bytes);
+  cancelled(signal);
+  const sheet=pdf.addPage([image.widthPt,image.heightPt]);
+  sheet.drawImage(png,{x:0,y:0,width:image.widthPt,height:image.heightPt});
+  onProgress({stage:'professional',detail:'compat_page_done',page,total:count});
+  await new Promise(resolve=>setTimeout(resolve,0));
+ }
+ cancelled(signal);
+ onProgress({stage:'professional',detail:'compat_save',page:count,total:count});
+ const bytes=await waitForImageOperation(pdf.save({useObjectStreams:true}),
+  signal,PDF_SAVE_TIMEOUT_MS,'COMPAT_PDF_SAVE_TIMEOUT');
+ cancelled(signal);
+ if(!(bytes instanceof Uint8Array)||bytes.byteLength>MAX_OUTPUT_BYTES)
+  throw Error('COMPAT_PDF_OUTPUT_BYTES_LIMIT');
+ assertCompletePdfBytes(bytes,MAX_OUTPUT_BYTES);
+ onProgress({stage:'professional',detail:'pdf_done',page:count,total:count});
+ return {
+  pdf:new Blob([bytes],{type:'application/pdf'}),pages:count,bytes:bytes.byteLength,
+  renderMode:'raster-compat',vectorPages:0,rasterPages:count,
+  warnings:[
+   '호환 방식으로 전체 페이지를 고해상도 이미지 PDF로 저장했습니다. 글자 검색·선택 및 벡터 객체 편집은 지원하지 않습니다.',
+   '복잡한 필터 및 글꼴 차이가 있을 수 있으므로 원본과 모든 페이지를 눈으로 비교하세요.'
+  ]
+ };
+}
diff --git a/browser-local/tests/compat-real-browser.mjs b/browser-local/tests/compat-real-browser.mjs
new file mode 100644
index 0000000..9d2542c
--- /dev/null
+++ b/browser-local/tests/compat-real-browser.mjs
@@ -0,0 +1,60 @@
+/**
+ * Playwright acceptance of the explicitly selected compatibility output.
+ * Uses published HWP/HWPX fixture files. Default professional conversion is
+ * covered by e2e.mjs; this test ensures a second, independent PDF writer works.
+ */
+import {chromium} from 'playwright';
+import {PDFDocument} from 'pdf-lib';
+import {existsSync,readFileSync,mkdirSync,writeFileSync} from 'node:fs';
+import {resolve} from 'node:path';
+const root=resolve(import.meta.dirname,'../..');
+const site=process.env.SUNRISE_TEST_URL||'http://127.0.0.1:8787/local/';
+const origin=new URL(site).origin;
+const output=resolve(root,'r29-browser-real-evidence');
+mkdirSync(output,{recursive:true});
+const reports=[];
+const browser=await chromium.launch({headless:true,args:['--no-sandbox']});
+try{
+ const page=await browser.newPage({acceptDownloads:true});
+ const external=[],errors=[],failedRequests=[];
+ page.on('pageerror',error=>errors.push(error.message));
+ page.on('requestfailed',request=>failedRequests.push(request.url()+': '+request.failure()?.errorText));
+ page.on('request',request=>{const u=request.url();if(!u.startsWith(origin+'/')&&!u.startsWith('data:')&&!u.startsWith('blob:'))external.push(u);});
+ await page.goto(site,{waitUntil:'networkidle',timeout:30000});
+ await page.waitForFunction(()=>/변환 준비 완료|초기화 실패|변환 기능 초기화 실패/.test(document.querySelector('#status')?.textContent||''),null,{timeout:90000});
+ const boot=await page.locator('#status').innerText();
+ if(!boot.includes('변환 준비 완료'))throw Error('WASM boot did not pass: '+boot);
+ if(await page.locator('#pdf-engine').inputValue()!=='professional')throw Error('default professional output changed');
+ await page.locator('details.options.advanced summary').click();
+ await page.locator('#pdf-engine').selectOption('compat-raster');
+ const files=['hwp','hwpx'].map(ext=>resolve(root,'r29-browser-fixtures/genuine.'+ext));
+ for(const file of files)if(!existsSync(file))throw Error('Missing acceptance fixture '+file);
+ await page.locator('#source').setInputFiles(files);
+ await page.locator('#convert').click();
+ await page.waitForFunction(()=>{
+  const completed=document.getElementById('done-count')?.textContent==='2';
+  const failed=Number(document.getElementById('failed-count')?.textContent||0)>0;
+  const idle=document.getElementById('cancel')?.disabled;
+  return (completed||failed)&&idle;
+ },null,{timeout:240000});
+ const done=await page.locator('#done-count').innerText();
+ if(done!=='2')throw Error('Compatibility PDF failed: '+(await page.locator('#file-list').innerText()));
+ const links=page.locator('#file-list a.download');
+ if(await links.count()!==2)throw Error('Expected 2 PDFs');
+ for(let i=0;i<2;i++){
+  const pending=page.waitForEvent('download',{timeout:30000});
+  await links.nth(i).click();
+  const download=await pending;
+  const filePath=resolve(output,'compat-genuine-'+(i===0?'hwp':'hwpx')+'.pdf');
+  await download.saveAs(filePath);
+  const data=readFileSync(filePath);
+  const document=await PDFDocument.load(data);
+  if(document.getPageCount()<1)throw Error('PDF has no pages');
+  reports.push({format:i===0?'hwp':'hwpx',pages:document.getPageCount(),size:data.length,status:'PASS'});
+ }
+ if(errors.length||external.length||failedRequests.length)throw Error(JSON.stringify({errors,external,failedRequests}));
+ await page.close();
+}finally{await browser.close();}
+reports.push({status:'PASS',engine:'opt-in compatibility raster',test:'real HWP/HWPX browser PDF downloads'});
+writeFileSync(resolve(output,'DEV26_COMPAT_BROWSER_E2E.json'),JSON.stringify(reports,null,2)+'\n');
+console.log(JSON.stringify(reports));
diff --git a/browser-local/tests/r66-real-failure-compat.mjs b/browser-local/tests/r66-real-failure-compat.mjs
new file mode 100644
index 0000000..8b00bb5
--- /dev/null
+++ b/browser-local/tests/r66-real-failure-compat.mjs
@@ -0,0 +1,87 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {buildRasterCompatibilityPdf} from '../src/raster-compat-pdf.mjs';
+
+const validPdf=new Uint8Array(readFileSync(new URL('./fixtures/r66-validated.pdf',import.meta.url)));
+const png=new Blob([new Uint8Array([137,80,78,71,13,10,26,10,0])],{type:'image/png'});
+function setup({count=2,pages=[],result=validPdf,controller,failPreprocess=false}={}){
+ const events=[];
+ const pdf={
+  saved:false,embedPng:async bytes=>{assert.ok(bytes instanceof Uint8Array);return {key:'png'};},
+  addPage:size=>{pages.push(size);return {drawImage:(image,settings)=>{assert.equal(image.key,'png');assert.equal(settings.width,size[0]);assert.equal(settings.height,size[1]);}};},
+  save:async()=>{pdf.saved=true;return result;}
+ };
+ const doc={renderPageSvgWithProfile:(i,profile)=>{assert.equal(profile,'print');return `<svg data-page="${i}"/>`;}};
+ return {doc,pdf,events,options:{
+  signal:controller?.signal,
+  onProgress:x=>events.push(x),
+  preprocessSvg:async(svg)=>{if(failPreprocess)throw Error('SVG_UNSAFE');return svg;},
+  rasterPage:async(svg)=>{assert.match(svg,/^<svg/);return {blob:png,widthPt:300,heightPt:600};},
+  loadPdfLib:async()=>({PDFDocument:{create:async()=>pdf}})
+ },count};
+}
+
+test('explicit compat generates full PDF from page images, preserves page count and warns about quality',async()=>{
+ const pages=[],x=setup({count:3,pages});
+ const r=await buildRasterCompatibilityPdf(x.doc,x.count,x.options);
+ assert.deepEqual(pages,[[300,600],[300,600],[300,600]]);
+ assert.equal(r.pages,3);assert.equal(r.renderMode,'raster-compat');
+ assert.equal(r.vectorPages,0);assert.equal(r.rasterPages,3);
+ assert.equal(r.bytes,validPdf.byteLength);assert.equal(r.pdf.type,'application/pdf');
+ assert.ok(r.warnings.some(s=>/검색/.test(s)));assert.ok(r.warnings.some(s=>/원본/.test(s)));
+ assert.equal(x.events.filter(e=>e.detail==='compat_page_done').length,3);
+ assert.equal(x.events.at(-1).detail,'pdf_done');
+});
+
+test('compat cancellation stops before reading another page or saving PDF',async()=>{
+ const abort=new AbortController(),x=setup({count:2,controller:abort});
+ x.options.rasterPage=async()=>{abort.abort();return {blob:png,widthPt:300,heightPt:600};};
+ await assert.rejects(buildRasterCompatibilityPdf(x.doc,x.count,x.options),e=>e.name==='AbortError');
+ assert.equal(x.pdf.saved,false);
+});
+
+test('compat writer cannot claim a truncated or invalid PDF as success',async()=>{
+ const x=setup({count:1,result:new Uint8Array([1,2,3,4,5])});
+ await assert.rejects(buildRasterCompatibilityPdf(x.doc,x.count,x.options),/PDF_OUTPUT_HEADER_INVALID/);
+});
+
+test('compat rejects unsafe source and malformed page image, rather than bypassing validation',async()=>{
+ const x=setup({count:1,failPreprocess:true});
+ await assert.rejects(buildRasterCompatibilityPdf(x.doc,x.count,x.options),/SVG_UNSAFE/);
+ const y=setup({count:1});y.options.rasterPage=async()=>({blob:png,widthPt:0,heightPt:600});
+ await assert.rejects(buildRasterCompatibilityPdf(y.doc,y.count,y.options),/COMPAT_PAGE_IMAGE_INVALID/);
+});
+
+test('compat is strictly opt-in; default vector engine does not silently rasterize a failed source',()=>{
+ const src=readFileSync(new URL('../src/converter.js',import.meta.url),'utf8');
+ const ui=readFileSync(new URL('../index.html',import.meta.url),'utf8');
+ assert.match(src,/if\(options\.engine==='compat-raster'\)/);
+ // The surrounding try/finally frees the WASM document. Await the async
+ // compatibility build before finally, else Chromium sees a freed Rust ptr.
+ assert.match(src,/return await buildRasterCompatibilityPdf\(doc,count,/);
+ assert.match(src,/allowRasterFallback:false/);
+ assert.match(src,/options=\{engine:'professional',\.\.\.options\}/);
+ assert.match(ui,/<option value="professional" selected>/);
+ assert.match(ui,/<option value="compat-raster">/);
+});
+
+test('compat output is bounded and per-page processing yields to cancellation',async()=>{
+ const x=setup({count:0});
+ await assert.rejects(buildRasterCompatibilityPdf(x.doc,x.count,x.options),/COMPAT_PAGE_COUNT_INVALID/);
+ const y=setup({count:121});
+ await assert.rejects(buildRasterCompatibilityPdf(y.doc,y.count,y.options),/COMPAT_PAGE_COUNT_INVALID/);
+});
+
+
+test('compat stages are whitelisted by both client and server telemetry and traced with real phases',()=>{
+ const client=readFileSync(new URL('../src/pro-telemetry.js',import.meta.url),'utf8');
+ const server=readFileSync(new URL('../../src/admin/handler.js',import.meta.url),'utf8');
+ const trace=readFileSync(new URL('../../src/trace-dev4-runtime.js',import.meta.url),'utf8');
+ for(const name of ['compat_raster','compat_page_done','compat_save']){
+  assert.match(client,new RegExp(name));
+  assert.match(server,new RegExp(name));
+ }
+ assert.match(trace,/image_\|compat_raster/);
+ assert.match(trace,/pdf_\|compat_save/);
+});
