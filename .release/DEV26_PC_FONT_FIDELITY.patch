+++ b/browser-local/tests/r66-local-font-fidelity.mjs
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {File} from 'node:buffer';
+import {readFileSync} from 'node:fs';
+import {localFamilyKeys,loadDocumentLocalFonts} from '../src/local-fonts.js';
+import {resolveFont} from '../src/pdf-fonts.js';
+
+globalThis.File ||= File;
+const svg=family=>`<svg xmlns="http://www.w3.org/2000/svg" font-family="${family}"/>`;
+class FakeParser {
+ parseFromString(source){
+  const name=/font-family="([^"]+)"/.exec(source)?.[1]||'';
+  return {documentElement:{localName:'svg',getAttribute:k=>k==='font-family'?name:null},
+   querySelector:()=>null,querySelectorAll:()=>[]};
+ }
+}
+const oldParser=globalThis.DOMParser;
+globalThis.DOMParser=FakeParser;
+const fontkit={create:bytes=>({familyName:'Malgun Gothic',fullName:'Malgun Gothic',
+ postscriptName:'MalgunGothic',subfamilyName:'Regular',characterSet:[0xac00,0xb098,65]})};
+const font=(family,blob=async()=>new Blob(['SFNT']))=>({family,fullName:family,postscriptName:family+'PS',style:'Regular',blob});
+
+test('Korean and English names of verified Windows faces are equivalent, not fuzzy matched',()=>{
+ assert(localFamilyKeys('Malgun Gothic').has('맑은고딕'));
+ assert(localFamilyKeys('맑은 고딕').has('malgungothic'));
+ assert(localFamilyKeys('GulimChe').has('굴림체'));
+ assert(!localFamilyKeys('Malgun Gothic UI').has('맑은고딕'));
+ assert(!localFamilyKeys('GulimChe').has('굴림'));
+});
+
+test('Windows English metadata is registered as original Korean font family for PDF glyphs',async()=>{
+ const original=globalThis.DOMParser;globalThis.DOMParser=FakeParser;
+ try{
+  let readCount=0;
+  const doc={renderPageSvgWithProfile:()=>svg('맑은 고딕')};
+  const fonts=[font('Malgun Gothic',async()=>{readCount++;return new Blob(['BINARY'])}),
+   font('Other Font',async()=>{throw Error('unrelated never read')})];
+  const result=await loadDocumentLocalFonts(doc,1,fonts,fontkit);
+  assert.equal(readCount,1);
+  assert.equal(result.faces.length,1);
+  assert.deepEqual(result.faces[0].cssAliases,['맑은 고딕']);
+  assert(result.faces[0].aliases.includes('맑은고딕'));
+  assert.equal(result.unmatchedNames.length,0);
+  assert.equal(resolveFont({faces:result.faces},'맑은 고딕','normal','normal','가').isLocal,true);
+ }finally{globalThis.DOMParser=original;}
+});
+
+test('frequently used HWP families are read before alphabetic OS font enumeration',async()=>{
+ const original=globalThis.DOMParser;globalThis.DOMParser=FakeParser;
+ try{
+  let page=0;const read=[];
+  const doc={renderPageSvgWithProfile:()=>svg(['Rare','Most Frequent','Most Frequent'][page++])};
+  const available=[font('Rare',async()=>{read.push('Rare');return new Blob(['R'])}),
+   font('Most Frequent',async()=>{read.push('Most Frequent');return new Blob(['F'])})];
+  const result=await loadDocumentLocalFonts(doc,3,available,fontkit);
+  assert.deepEqual(read,['Most Frequent','Rare']);
+  assert.equal(result.matchedFontData,2);
+ }finally{globalThis.DOMParser=original;}
+});
+
+test('unsupported or unreadable families are counted and named locally without lying about installed fonts',async()=>{
+ const original=globalThis.DOMParser;globalThis.DOMParser=FakeParser;
+ try{
+  const doc={renderPageSvgWithProfile:()=>svg('미등록특수글꼴')};
+  const absent=await loadDocumentLocalFonts(doc,1,[font('Malgun Gothic')],fontkit);
+  assert.equal(absent.requestedFamilies,1);
+  assert.equal(absent.matchedFontData,0);
+  assert.deepEqual(absent.unmatchedNames,['미등록특수글꼴']);
+  const unreadable=await loadDocumentLocalFonts(doc,1,[font('미등록특수글꼴',async()=>{throw Error('access denied to bytes')})],fontkit);
+  assert.equal(unreadable.matchedFontData,1);
+  assert.equal(unreadable.unreadableFonts,1);
+  assert.deepEqual(unreadable.unmatchedNames,['미등록특수글꼴']);
+ }finally{globalThis.DOMParser=original;}
+});
+
+test('explicit PC font status and compatibility raster must not request irrelevant local fonts',()=>{
+ const src=new URL('../src/',import.meta.url);
+ const main=readFileSync(new URL('main.js',src),'utf8');
+ const html=readFileSync(new URL('../index.html',import.meta.url),'utf8');
+ assert.match(main,/engine!=='compat-raster'&&pending\.some/);
+ assert.match(main,/font-check'\)\?\.addEventListener\('click'/);
+ assert.match(main,/fontStatus\(access\.status==='ready'/);
+ assert.match(html,/id="font-check"/);
+ assert.match(html,/id="pc-font-status"/);
+});
diff --git a/browser-local/tests/r66-local-font-browser.mjs b/browser-local/tests/r66-local-font-browser.mjs
new file mode 100644
--- /dev/null
+++ b/browser-local/tests/r66-local-font-browser.mjs
@@ -0,0 +1,50 @@
+/**
+ * Browser integration of the on-device PC font contract. A LOCAL test font
+ * simulates FontData from a permitted OS: it is not a claim that the CI
+ * runner has Korean Windows fonts installed. The bytes are real OFL SFNT.
+ */
+import {chromium} from 'playwright';
+import {spawn} from 'node:child_process';
+import {setTimeout as sleep} from 'node:timers/promises';
+import {get} from 'node:http';
+import {resolve} from 'node:path';
+const root=resolve(import.meta.dirname,'..');
+const base='http://127.0.0.1:4193/';
+const server=spawn(process.execPath,['node_modules/vite/bin/vite.js','--host','127.0.0.1','--port','4193','--strictPort'],{cwd:root,stdio:'ignore'});
+let browser;
+try{
+ let ok=false;
+ for(let n=0;n<80;n++){
+  if(server.exitCode!==null)throw Error('Vite exited '+server.exitCode);
+  try{
+   const code=await new Promise((resolve,reject)=>get(base,r=>{r.resume();resolve(r.statusCode);}).on('error',reject));
+   if(code===200){ok=true;break;}
+  }catch{}
+  await sleep(250);
+ }
+ if(!ok)throw Error('Font test Vite startup timeout');
+ browser=await chromium.launch({headless:true,args:['--no-sandbox']});
+ const page=await browser.newPage();
+ await page.goto(base,{waitUntil:'networkidle'});
+ await page.waitForFunction(()=>document.querySelector('#status')?.textContent.includes('변환 준비 완료'),null,{timeout:90000});
+ await page.locator('details.options.advanced summary').click();
+ const available=await page.evaluate(async()=>{
+  const font=await fetch('/fonts/NanumGothic-Regular.ttf');
+  if(!font.ok)throw Error('test OFL font missing');
+  const payload=await font.blob();
+  window.queryLocalFonts=async()=>[{family:'Nanum Gothic',fullName:'Nanum Gothic',
+   postscriptName:'NanumGothic',style:'Regular',blob:async()=>payload}];
+  return payload.size;
+ });
+ if(available<1000)throw Error('test font bytes missing');
+ await page.locator('#font-check').click();
+ await page.waitForFunction(()=>document.querySelector('#pc-font-status')?.textContent.includes('1개에 접근 가능합니다'),null,{timeout:20000});
+ const report=await page.evaluate(async()=>{
+  const {verifyBilingualLocalFontPdf}=await import('/tests/r66-local-font-browser-entry.js');
+  return verifyBilingualLocalFontPdf();
+ });
+ if(report.signature!=='%PDF-'||report.fontUsage.local!==1||report.missing.length||report.localFaces!==1)
+  throw Error('Local PDF font browser integration failed: '+JSON.stringify(report));
+ console.log('LOCAL_FONT_BILINGUAL_BROWSER_AND_EMBED_PASS '+JSON.stringify(report));
+ await page.close();
+}finally{await browser?.close();server.kill('SIGTERM');}
diff --git a/browser-local/tests/r66-local-font-browser-entry.js b/browser-local/tests/r66-local-font-browser-entry.js
new file mode 100644
--- /dev/null
+++ b/browser-local/tests/r66-local-font-browser-entry.js
@@ -0,0 +1,25 @@
+// Served as a Vite module so bare npm imports resolve inside Chromium.
+// This models a user-approved FontData with the bytes of a real OFL font.
+import fontkit from '@pdf-lib/fontkit';
+import {loadDocumentLocalFonts} from '../src/local-fonts.js';
+import {resolveFont,installMeasureFonts} from '../src/pdf-fonts.js';
+import {tryProfessionalDocument} from '../src/svg-professional.js';
+
+export async function verifyBilingualLocalFontPdf(){
+ const svg='<svg xmlns="http://www.w3.org/2000/svg" width="794" height="1123"><text x="20" y="55" font-family="나눔고딕" font-size="22">가나다</text></svg>';
+ const doc={renderPageSvgWithProfile:()=>svg};
+ const registry=await loadDocumentLocalFonts(doc,1,await window.queryLocalFonts(),fontkit);
+ const selected=resolveFont(registry,'나눔고딕','normal','normal','가나다');
+ if(!selected?.isLocal)throw Error('Korean font family did not choose the local face');
+ const release=await installMeasureFonts(registry);
+ let pdf;
+ try{
+  pdf=await tryProfessionalDocument(doc,1,{
+   checkedSvg:()=>({svg,width:794,height:1123}),fontRegistry:registry,
+   rasterPage:async()=>{throw Error('raster unexpectedly used')}
+  });
+ }finally{release();}
+ const head=new Uint8Array(await pdf.pdf.slice(0,5).arrayBuffer());
+ return {pdfBytes:pdf.pdf.size,signature:String.fromCharCode(...head),
+  fontUsage:pdf.fontUsage,missing:registry.unmatchedNames,localFaces:registry.faces.length};
+}
