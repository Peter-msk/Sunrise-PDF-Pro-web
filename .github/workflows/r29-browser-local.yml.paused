name: R40 Professional Batch PDF Real Browser E2E
on:
  workflow_dispatch:
  push:
    branches: [main, release/r40-dev4-20261106, 'fix/**']
    paths:
      - 'browser-local/**'
      - '.github/workflows/r29-browser-local.yml'
      - '.gitmodules'
      - 'src/worker.js'
      - 'wrangler.jsonc'
      - 'package.json'
      - 'scripts/test-worker-assets.mjs'
      - 'scripts/verify-browser-build.mjs'
permissions:
  contents: read
jobs:
  browser-only-hwp-hwpx:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5
        with:
          persist-credentials: false
          submodules: false
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - name: Build and test pinned browser converter and Worker assets
        run: npm run build
      - name: Verify Wrangler Worker plus Static Assets deployment package
        run: npx --yes wrangler@4 deploy --dry-run --outdir /tmp/sunrise-pdf-pro-worker-dryrun
      - name: Inspect self-hosted WASM assets
        shell: bash
        run: |
          set -euo pipefail
          test -s browser-local/dist/rhwp_bg.wasm
          test -f browser-local/dist/index.html
          test -f browser-local/dist/app.html
          find browser-local/dist -maxdepth 3 -type f -printf '%p %s bytes\n'
          mkdir -p r29-browser-real-evidence
          sha256sum browser-local/dist/rhwp_bg.wasm > r29-browser-real-evidence/official-wasm-sha256.txt
      - name: Install Chromium for browser conversion test
        working-directory: browser-local
        run: npx playwright install --with-deps chromium
      - name: Fetch genuine upstream HWP/HWPX fixtures
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p r29-browser-fixtures
          curl --fail --location --retry 3 \
            'https://raw.githubusercontent.com/edwardkim/rhwp/v0.8.7/samples/re-01-hangul-only-hancom.hwp' \
            -o r29-browser-fixtures/genuine.hwp
          curl --fail --location --retry 3 \
            'https://raw.githubusercontent.com/edwardkim/rhwp/v0.8.7/samples/tac-host-spacing.hwpx' \
            -o r29-browser-fixtures/genuine.hwpx
      - name: Launch real local Cloudflare Worker and verify self-hosted WASM
        shell: bash
        run: |
          set -euo pipefail
          npx --yes wrangler@4 dev --local --ip 127.0.0.1 --port 8787 > /tmp/sunrise-r31-worker.log 2>&1 &
          echo $! > /tmp/sunrise-r31-worker.pid
          for i in $(seq 1 60); do
            if curl -fsS http://127.0.0.1:8787/local/health > /tmp/sunrise-r31-health.json; then break; fi
            sleep 1
          done
          python - <<'PY'
          import json
          j=json.load(open('/tmp/sunrise-r31-health.json'))
          assert j['wasm_delivery']=='cloudflare-static-assets'
          assert j['quality_target_dpi']==300
          assert not j['document_upload']
          PY
          curl -fsSL --max-time 90 http://127.0.0.1:8787/local/rhwp_bg.wasm -o /tmp/sunrise-r31-rhwp_bg.wasm
          echo '54cf95014312e605c51b98eb9021247ea79ef2bbd0a7080e11c011d0246e3989  /tmp/sunrise-r31-rhwp_bg.wasm' | sha256sum -c -
          curl -fsS http://127.0.0.1:8787/local/ -o /tmp/sunrise-r31-page.html
          grep -q 'HWP/HWPX' /tmp/sunrise-r31-page.html
      - name: REAL Chromium Professional HWP/HWPX Batch PDF + ZIP through Cloudflare Worker
        shell: bash
        env:
          SUNRISE_TEST_URL: http://127.0.0.1:8787/local/
        run: node browser-local/tests/e2e.mjs
      - name: Check downloaded PDFs with pypdf
        shell: bash
        run: |
          python -m pip install --disable-pip-version-check 'pypdf==5.9.0'
          python - <<'PY'
          from pathlib import Path
          import hashlib,json
          from pypdf import PdfReader
          out={}
          for ext in ('hwp','hwpx'):
              f=Path('r29-browser-real-evidence')/f'browser-genuine-{ext}.pdf'
              assert f.is_file() and f.stat().st_size>500 and f.read_bytes()[:5]==b'%PDF-',ext
              d=PdfReader(str(f),strict=True)
              assert len(d.pages)>0 and not d.is_encrypted,ext
              
              extracted=''.join(page.extract_text() or '' for page in d.pages).strip()
              image_objects=[]
              for page in d.pages:
                  resources=page.get('/Resources')
                  resources=resources.get_object() if resources else {}
                  xobjects=resources.get('/XObject')
                  for obj in (xobjects.get_object().values() if xobjects else []):
                      target=obj.get_object()
                      if target.get('/Subtype')=='/Image': image_objects.append(target)
              assert extracted, f'{ext}: PDF text is not extractable'
              assert not image_objects, f'{ext}: default output unexpectedly contains raster image objects'
              out[ext]={'pages':len(d.pages),'bytes':f.stat().st_size,'text_length':len(extracted),'image_xobjects':0,'sha256':hashlib.sha256(f.read_bytes()).hexdigest(),'status':'PASS'}
          Path('r29-browser-real-evidence/R40_BROWSER_PDF_CHECK.json').write_text(json.dumps(out,ensure_ascii=False,indent=2))
          print(json.dumps(out,indent=2))
          PY
      - name: Attach browser-generated PDFs and evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: r29-browser-local-rhwp-pdf-evidence
          path: |
            r29-browser-real-evidence/
            browser-local/package-lock.json
          if-no-files-found: warn
          retention-days: 7
