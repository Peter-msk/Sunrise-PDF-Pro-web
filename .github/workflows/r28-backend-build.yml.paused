name: R28 Linux Backend Docker Build and Import

on:
  workflow_dispatch:
  push:
    paths:
      - 'backend/**'
      - '.github/workflows/r28-backend-build.yml'

permissions:
  contents: read

jobs:
  backend-container-build:
    runs-on: ubuntu-24.04
    timeout-minutes: 25
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4 pinned
        with:
          persist-credentials: false
      - name: Validate backend source archive sha256
        shell: bash
        run: |
          echo 'c7b430c663f41491922855704df065f81eebfd9fb3e732de404356d113c1f9c4  backend/r28_backend_runtime.tar.gz' | sha256sum -c -
          tar -tzf backend/r28_backend_runtime.tar.gz | grep -Fx 'cloud/edge_auth.py'
          tar -tzf backend/r28_backend_runtime.tar.gz | grep -Fx 'cloud/app.py'
      - name: Build immutable official rhwp Linux conversion origin
        shell: bash
        run: |
          docker build --progress=plain --pull -f backend/Dockerfile -t sunrise-pdf-pro-origin:r28 .
      - name: Check real packaged rhwp version
        shell: bash
        run: |
          docker run --rm --entrypoint /usr/local/bin/rhwp sunrise-pdf-pro-origin:r28 --version | tee version.txt
          grep -Fx 'rhwp v0.8.7' version.txt
      - name: Check Python app import and HMAC gate module
        shell: bash
        run: |
          docker run --rm --entrypoint python sunrise-pdf-pro-origin:r28 -c \
            'from cloud.app import app; from cloud.edge_auth import EdgeAuthenticator; assert app is not None; print("PYTHON_RUNTIME_IMPORT_PASS")'
      - name: Genuine HWP and HWPX conversions INSIDE packaged Linux Docker image
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p r28-docker-real
          curl --fail --location --retry 3 --connect-timeout 15 --max-time 60 \
            'https://raw.githubusercontent.com/edwardkim/rhwp/v0.8.7/samples/re-01-hangul-only-hancom.hwp' \
            -o r28-docker-real/genuine.hwp
          curl --fail --location --retry 3 --connect-timeout 15 --max-time 60 \
            'https://raw.githubusercontent.com/edwardkim/rhwp/v0.8.7/samples/tac-host-spacing.hwpx' \
            -o r28-docker-real/genuine.hwpx
          chmod 777 r28-docker-real
          docker run --rm -v "$PWD/r28-docker-real:/data" \
            --entrypoint /usr/local/bin/rhwp sunrise-pdf-pro-origin:r28 \
            export-pdf /data/genuine.hwp -o /data/genuine-hwp.pdf
          docker run --rm -v "$PWD/r28-docker-real:/data" \
            --entrypoint /usr/local/bin/rhwp sunrise-pdf-pro-origin:r28 \
            export-pdf /data/genuine.hwpx -o /data/genuine-hwpx.pdf
          python -m pip install --disable-pip-version-check 'pypdf==5.9.0'
          python scripts/r28_real_rhwp_acceptance.py r28-docker-real
      - name: Record package evidence
        shell: bash
        run: |
          docker image inspect sunrise-pdf-pro-origin:r28 --format '{{.Id}}' | tee backend-image-id.txt
          sha256sum backend/r28_backend_runtime.tar.gz >> backend-image-id.txt
      - name: Upload non-secret build evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4 pinned
        with:
          name: r28-linux-backend-build-evidence
          path: |
            backend-image-id.txt
            version.txt
            r28-docker-real/genuine-hwp.pdf
            r28-docker-real/genuine-hwpx.pdf
            r28-docker-real/R28_RHWP_REAL_ACCEPTANCE.json
          if-no-files-found: warn
          retention-days: 7
